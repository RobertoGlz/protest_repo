. /* ============================================================
>    PANEL B: Other Non-Apex (in_na == 1)
>    ============================================================ */
. eststo clear

. forvalues k = 1/`ols_n' {
  2.         local outcome : word `k' of `ols_out'
  3.         local window  : word `k' of `ols_win'
  4.         local bin_size = cond(`window' == 30, 6, 30)
  5. 
.         use `base', clear
  6.         if `window' == 30 {
  7.                 eststo m`k': reghdfe `outcome' post i.month i.day ///
>                         if year >= `firstyear' & abs(window) <= 30 & in_na ==
>  1, ///
>                         absorb($fe1) vce($CLUSTER2)
  8.         }
  9.         else {
 10.                 eststo m`k': reghdfe `outcome' post i.month i.day ///
>                         if year >= `firstyear' & in_na == 1, ///
>                         absorb($fe1) vce($CLUSTER2)
 11.         }
 12. 
.         quietly summarize `outcome' if e(sample) ///
>                 & window >= -`bin_size' & window <= -1
 13.         estadd scalar baseline = r(mean)
 14. 
.         quietly levelsof id if e(sample) == 1
 15.         estadd scalar num_scandals = r(r)
 16. }
