. do "${progdir}/define_panelcombine.do"

. /* --------------------------------------------------------------------------
> --
>    Project: Apex corruption protests paper
> 
>    Code author: steveofconnell (original)
>    Modifications: Roberto Gonzalez
> 
>    Objective: Define a panelcombine program that handles booktabs rules
>               rather than hlines. Source the program at the top of any
>               analysis do-file that builds a multi-panel table.
> 
>    Source of the original program:
>      https://raw.githubusercontent.com/steveofconnell/PanelCombine/master/Pan
> elCombine.do
>    Copied verbatim from the religion_project_repo project's
>      code/programs/define_panelcombine.do
>    so this project does not depend on a sibling repository at build time.
> ---------------------------------------------------------------------------- 
> */
. 
. cap prog drop panelcombine

. prog define panelcombine
  1. qui {
  2. syntax, use(str asis) paneltitles(str asis) columncount(integer) save(str)
>  [CLEANup]
  3. preserve
  4. 
. tokenize `"`paneltitles'"'
  5. //read in loop
. local num 1
  6. while "``num''"~="" {
  7. local panel`num'title="``num''"
  8. local num=`num'+1
  9. }
 10. 
. 
. tokenize `"`use'"'
 11. //read in loop
. local num 1
 12. while `"``num''"'~="" {
 13. local filepath `"``num''"'
 14. tempfile temp`num'
 15. insheet using `"`filepath'"', clear
 16. save `temp`num''
 17. local max = `num'
 18. local num=`num'+1
 19. }
 20. 
. //conditional processing loop
. tokenize `"`use'"'
 21. local num 1
 22. while `"``num''"'~="" {
 23. local panellabel : word `num' of `c(ALPHA)'
 24. use `temp`num'', clear
 25.         if `num'==1 { //process first panel -- clip bottom
 26.         drop if strpos(v1,"Note:")>0 | strpos(v1,"in parentheses")>0 | str
> pos(v1,"p<0")>0
 27.         drop if v1=="\end{tabular}" | v1=="}"
 28.         /* Replace ONLY the first occurrence of \midrule with the Panel A
>            header. Using cumulative-sum-of-flag is robust to the row
>            position changing because of mgroups, multi-row column
>            headers, etc. */
.         gen byte _is_mid = (v1 == "\midrule")
 29.         gen long _midnum = sum(_is_mid)
 30.         replace v1 = "\midrule \multicolumn{`columncount'}{l}{\textbf{\tex
> tit{Panel `panellabel': `panel1title'}}} \\" if _is_mid == 1 & _midnum == 1
 31.         drop _is_mid _midnum
 32.         replace v1 = "\midrule" if v1=="\bottomrule" & _n>4 //this is inte
> nded to replace the bottom double line; more robust condition probably exists
 33.         }
 34.         else if `num'==`max' { //process final panel -- clip top
 35.         //process header to drop everything until first hline
.         g temp = (v1 == "\midrule")
 36.         replace temp = temp+temp[_n-1] if _n>1
 37.         drop if temp==0
 38.         drop temp
 39. 
.         replace v1 = " \multicolumn{`columncount'}{l}{\textbf{\textit{Panel `
> panellabel': `panel`num'title'}}} \\" if _n==1
 40.         }
 41.         else { //process middle panels -- clip top and bottom
 42.         //process header to drop everything until first hline
.         g temp = (v1 == "\midrule")
 43.         replace temp = temp+temp[_n-1] if _n>1
 44.         drop if temp==0
 45.         drop temp
 46. 
.         replace v1 = " \multicolumn{`columncount'}{l}{\textbf{\textit{Panel `
> panellabel': `panel`num'title'}}} \\" if _n==1
 47.         drop if strpos(v1,"Note:")>0 | strpos(v1,"in parentheses")>0 | str
> pos(v1,"p<0")>0
 48.         drop if v1=="\end{tabular}" | v1=="}"
 49.         replace v1 = "\bottomrule" if v1=="\bottomrule\bottomrule"
 50.         }
 51.         save `temp`num'', replace
 52. local num=`num'+1
 53. }
 54. 
. use `temp1',clear
 55. local num 2
 56. while "``num''"~="" {
 57. append using `temp`num''
 58. local num=`num'+1
 59. }
 60. 
. outsheet using `save', noname replace noquote
 61. 
. 
.         if "`cleanup'"!="" { //erasure loop
 62.         tokenize `"`use'"'
 63.         local num 1
 64.                 while `"``num''"'~="" {
 65.                 local filepath `"``num''"'
 66.                 erase `"`filepath'"'
 67.                 local num=`num'+1
 68.                 }
 69.         }
 70. 
. restore
 71. }
 72. end

. 
end of do-file

. 
. global fe1      "i.country_id#i.year"

. global CLUSTER2 "cluster i.country_id#i.year#i.grupo_dias"

. local  firstyear = 2008

. 
. /* ============================================================
>    Loop over estimator (ols/poi) and panel.  Each panel loads its
>    own source dataset directly from disk.
>    ============================================================ */
. foreach est in ols poi {
  2. 
.         /* six cells: (violent, peaceful) x (30, 60, 90) -- +-120 dropped */
.         local out_list "num_violent_MM num_peaceful_MM num_violent_MM num_pea
> ceful_MM num_violent_MM num_peaceful_MM"
  3.         local win_list "30 30 60 60 90 90"
  4.         local ncell : word count `out_list'
  5. 
.         foreach p in corrpa corrna football deprec {
  6. 
.                 /* ---------- load + prep this panel's data ---------- */
.                 if "`p'" == "corrpa" | "`p'" == "corrna" {
  7.                         import delimited using "${datfin}/scandals_classif
> ied.csv", ///
>                                 clear varnames(1) bindquotes(strict)
  8.                         keep id country position
  9.                         tempfile cls
 10.                         save `cls'
 11. 
.                         use "${datfin}/protests_scandals_30days_v3", clear
 12.                         drop if country == "Venezuela"
 13.                         merge m:1 id country using `cls', keep(1 3) nogene
> rate
 14. 
.                         gen byte in_pa = 0
 15.                         replace in_pa = 1 if position == "president"
 16.                         replace in_pa = 1 if position == "governor"
 17.                         replace in_pa = 1 if position == "sc_judge_congres
> sman" & ///
>                                 inlist(id, "202", "NEW26", "NEW30", "332")
 18. 
.                         gen byte in_na = 0
 19.                         replace in_na = 1 if position == "sc_judge_congres
> sman" & ///
>                                 !inlist(id, "202", "NEW26", "NEW30", "332")
 20.                         replace in_na = 1 if position == "other_judiciary"
 21.                         replace in_na = 1 if position == "others"
 22. 
.                         if "`p'" == "corrpa" local flag "in_pa"
 23.                         else                 local flag "in_na"
 24.                 }
 25.                 else if "`p'" == "football" {
 26.                         use "${datfin}/protests_scandals_30days_football_v
> 3", clear
 27.                         drop if country == "Venezuela"
 28.                         gen byte keepall = 1
 29.                         local flag "keepall"
 30.                 }
 31.                 else if "`p'" == "deprec" {
 32.                         use "${datfin}/protests_scandals_30days_depreciati
> on_v3", clear
 33.                         drop if country == "Venezuela"
 34.                         gen byte keepall = 1
 35.                         local flag "keepall"
 36.                 }
 37. 
.                 egen grupo_dias = group(s_lag30 s_lag60 s_lag90 s_lag120 ///
>                                         s_lead30 s_lead60 s_lead90 s_lead120)
 38. 
.                 tempfile pdata
 39.                 save `pdata'
 40. 
.                 /* ---------- run the eight cells ---------- */
.                 eststo clear
 41.                 forvalues k = 1/`ncell' {
 42.                         local outcome : word `k' of `out_list'
 43.                         local window  : word `k' of `win_list'
 44. 
.                         use `pdata', clear
 45.                         if "`est'" == "ols" {
 46.                                 eststo m`k': reghdfe `outcome' post i.mont
> h i.day ///
>                                         if year >= `firstyear' & abs(window) 
> <= `window' & `flag' == 1, ///
>                                         absorb($fe1) vce($CLUSTER2)
 47.                         }
 48.                         else {
 49.                                 capture eststo m`k': ppmlhdfe `outcome' po
> st ///
>                                         if year >= `firstyear' & abs(window) 
> <= `window' & `flag' == 1, ///
>                                         absorb(month day $fe1) vce($CLUSTER2)
 50.                         }
 51. 
.                         /* pre-scandal mean over the SAME +-window as the col
> umn */
.                         quietly summarize `outcome' if e(sample) ///
>                                 & window >= -`window' & window <= -1
 52.                         estadd scalar baseline = r(mean)
 53. 
.                         capture quietly levelsof id if e(sample) == 1
 54.                         if _rc == 0 estadd scalar num_events = r(r)
 55.                 }
 56. 
.                 /* ---------- write this panel's temp table ---------- */
.                 if "`est'" == "ols" {
 57.                         local eformopt ""
 58.                         local r2stat   "r2"
 59.                         local r2lab    "R-squared"
 60.                         local postlab  "Post Event"
 61.                 }
 62.                 else {
 63.                         local eformopt "eform"
 64.                         local r2stat   "r2_p"
 65.                         local r2lab    "Pseudo R-squared"
 66.                         local postlab  "Post Event (IRR)"
 67.                 }
 68. 
.                 esttab m1 m2 m3 m4 m5 m6 using "${tables}/bench_`est'_`p'_tem
> p.tex", ///
>                         replace booktabs nonotes nogaps b(3) se(3) `eformopt'
>  ///
>                         star(* 0.10 ** 0.05 *** 0.01) ///
>                         mtitles("\shortstack{Violent\Protests}" ///
>                                 "\shortstack{Peaceful\Protests}" ///
>                                 "\shortstack{Violent\Protests}" ///
>                                 "\shortstack{Peaceful\Protests}" ///
>                                 "\shortstack{Violent\Protests}" ///
>                                 "\shortstack{Peaceful\Protests}") ///
>                         mgroups("$\pm 30$-Day Window" "$\pm 60$-Day Window" /
> //
>                                 "$\pm 90$-Day Window", ///
>                                 pattern(1 0 1 0 1 0) ///
>                                 prefix(\multicolumn{2}{c}{) suffix(}) span //
> /
>                                 erepeat(\cmidrule(lr){@span})) ///
>                         stats(baseline N num_events `r2stat', ///
>                               label("Mean (Pre-Event)" "Observations" ///
>                                     "Number of Events" "`r2lab'") ///
>                               fmt(3 0 0 3)) ///
>                         keep(post) coeflabels(post "`postlab'")
 69.         }
 70. 
.         /* ---------- combine the four panels ---------- */
.         if "`est'" == "ols" local outname "sup_benchmarks_ols_panels.tex"
 71.         else                 local outname "sup_benchmarks_poi_panels.tex"
 72. 
.         panelcombine, ///
>                 use("${tables}/bench_`est'_corrpa_temp.tex" ///
>                     "${tables}/bench_`est'_corrna_temp.tex" ///
>                     "${tables}/bench_`est'_football_temp.tex" ///
>                     "${tables}/bench_`est'_deprec_temp.tex") ///
>                 paneltitles("Apex" "Non-Apex" ///
>                             "Football match losses" "Currency depreciations")
>  ///
>                 columncount(7) ///
>                 save("${tables}/`outname'") ///
>                 cleanup
 73. }
