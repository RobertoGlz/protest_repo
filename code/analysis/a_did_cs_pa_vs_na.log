. do a_did_cs_pa_vs_na.do 

. /* --------------------------------------------------------------------------
> --
>                     Violent effects of apex corruption
> 
>     Code author: Roberto Gonzalez
>     Date: 2026-07-25
> 
>     Objective:
>         Callaway & Sant'Anna (2021) doubly-robust staggered DiD as a ROBUSTNE
> SS
>         check, in the spirit of Acemoglu, Naidu, Restrepo & Robinson (2019,
>         Table 5): the same estimator run three ways,
> 
>             method(reg)    = outcome-regression adjustment      (their Panel 
> A)
>             method(ipw)    = inverse-propensity-score weighting  (their Panel
>  B)
>             method(dripw)  = doubly robust                       (their Panel
>  C)
> 
>         conditioning on a BASELINE pre-scandal protest covariate -- the direc
> t
>         analog of Acemoglu et al.'s "four lags of GDP".  The event-study
>         aggregation gives the pre-scandal placebo (lead) coefficients, so we 
> can
>         show a FLAT pre-trend before disclosure and a robust post effect.
> 
>         Run SEPARATELY on the two apex-partition subsamples of main Table~1:
>             - pa : President + Other Apex   scandals
>             - na : Other Non-Apex           scandals
>         on a country x 15-day-bin panel, aggregated to +-60/90/120-day window
> s.
> 
>     Control group (clean):
>         Treated  = countries with an in-subsample (pa/na) scandal; cohort = b
> in
>                    of their FIRST such scandal.
>         Controls = countries with NO scandal of ANY type over 2008-2018
>                    (gvar = 0, never treated).  Countries that have scandals o
> nly
>                    of the OTHER type are dropped from the estimation, so the
>                    comparison group is clean, exactly as in the imputation an
> d
>                    stacked designs.
> 
>     Requires:  csdid, drdid  (ssc install csdid, replace ; ssc install drdid,
>  replace)
> 
>     Outputs (paper/{tables,figures}/):
>         - did_cs_es_mm_violent_<sample>_w<T>.pdf   (event study: reg/ipw/dr o
> verlaid)
>         - did_cs_main_<sample>.tex                  (windowed ATT + pre-trend
>  p)
>       where <sample> in {pa, na}, <T> in {60, 90, 120}.
> ---------------------------------------------------------------------------- 
> */
. 
. set more off

. clear all

. 
. capture which csdid

. if _rc ssc install csdid, replace

. capture which drdid

. if _rc ssc install drdid, replace

. 
. if "`c(username)'" == "lalov" {
.         gl identity "C:\Users\lalov\ITAM Seira Research Dropbox\Eduardo River
> a"
. }

. if "`c(username)'" == "Rob_9" {
.         global identity "C:/Users/Rob_9/Dropbox"
. }

. if "`c(username)'" == "rob98" {
.         global identity "~/Dropbox"
. }

. 
. global work   "${identity}/Corrupcion/Protest_Work"

. global path   "${identity}/Corrupcion/WORKING FOLDER/Event Study - Scandals"

. global datfin "${path}/Data/final"

. global tabout "${identity}/Corrupcion/protest_repo/paper/tables"

. global figout "${identity}/Corrupcion/protest_repo/paper/figures"

. 
. local BIN = 15                       /* bin width in days */

. 
. /* ============================================================
>    STEP 0 - subsample-specific first-scandal date per country
>    ============================================================ */
. import delimited using "${datfin}/scandals_classified.csv", ///
>         clear varnames(1) bindquotes(strict)
(encoding automatically selected: UTF-8)
(7 vars, 190 obs)

. keep id country position

. tempfile cls

. save `cls'
file C:\Users\rob98\AppData\Local\Temp\ST_d984_000001.tmp saved as .dta
    format

. 
. use "${datfin}/protests_scandals_30days_v3", clear

. keep if window == 0
(45,841 observations deleted)

. drop if country == "Venezuela"
(14 observations deleted)

. merge m:1 id country using `cls', keep(1 3) generate(_mclass)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                               176  (_mclass==3)
    -----------------------------------------

. 
. gen byte in_pa = 0

. replace in_pa = 1 if position == "president"
(45 real changes made)

. replace in_pa = 1 if position == "governor"
(14 real changes made)

. replace in_pa = 1 if position == "sc_judge_congressman" & ///
>         inlist(id, "202", "NEW26", "NEW30", "332", "NEW23")
(5 real changes made)

. 
. gen byte in_na = 0

. replace in_na = 1 if position == "sc_judge_congressman" & ///
>         !inlist(id, "202", "NEW26", "NEW30", "332", "NEW23")
(13 real changes made)

. replace in_na = 1 if position == "other_judiciary"
(16 real changes made)

. replace in_na = 1 if position == "others"
(83 real changes made)

. 
. preserve

.         keep if in_pa == 1
(112 observations deleted)

.         bysort country: egen double fs_pa = min(date)

.         format fs_pa %td

.         keep country fs_pa

.         duplicates drop

Duplicates in terms of all variables

(52 observations deleted)

.         tempfile pa_dates

.         save `pa_dates'
file C:\Users\rob98\AppData\Local\Temp\ST_d984_000003.tmp saved as .dta
    format

. restore

. 
. preserve

.         keep if in_na == 1
(64 observations deleted)

.         bysort country: egen double fs_na = min(date)

.         format fs_na %td

.         keep country fs_na

.         duplicates drop

Duplicates in terms of all variables

(96 observations deleted)

.         tempfile na_dates

.         save `na_dates'
file C:\Users\rob98\AppData\Local\Temp\ST_d984_000005.tmp saved as .dta
    format

. restore

. 
. /* ============================================================
>    STEP 1 - collapse the country-DAY panel into 15-day calendar
>    bins on a fixed grid anchored on 1 Jan 2008.
>    ============================================================ */
. use "${datfin}/panel_country_day.dta", clear

. keep if year >= 2008
(151,202 observations deleted)

. 
. local anchor = mdy(1, 1, 2008)

. gen long bin_idx = floor((date - `anchor') / `BIN') + 1

. 
. /* country has a scandal of ANY type in this country-year? */
. bysort country year: egen byte cy_scan = max(scandal_today)

. 
. collapse (sum) mm_protests mm_violent mm_nonviolent mm_gvr ///
>          (firstnm) country_id (max) cy_any_scandal = cy_scan, ///
>         by(country bin_idx)

. 
. gen long bin_start = `anchor' + (bin_idx - 1) * `BIN'

. format bin_start %td

. 
. /* a country that has NO scandal of any type in ANY year is a clean control *
> /
. bysort country: egen byte ever_any_scandal = max(cy_any_scandal)

. 
. tempfile binpanel

. save `binpanel'
file C:\Users\rob98\AppData\Local\Temp\ST_d984_000006.tmp saved as .dta
    format

. 
. /* postfile to accumulate the violent-outcome event-study paths for plotting 
> */
. tempname P

. tempfile plotdata

. postfile `P' str4 sample int T str8 method int etime double days ///
>         double b double se using "`plotdata'", replace
(file C:\Users\rob98\AppData\Local\Temp\ST_d984_000007.tmp not found)

. 
. /* ============================================================
>    SAMPLE LOOP
>    ============================================================ */
. foreach sample in pa na {
  2. 
.         di as result _newline _newline ///
>                 "============================================================
> ====="  _n ///
>                 "   CALLAWAY & SANT'ANNA DR-DiD  --  sample=`sample'"        
>          _n ///
>                 "============================================================
> ====="
  3. 
.         capture scalar drop _all   /* reset stored cells between subsamples *
> /
  4. 
.         /* ---- attach the subsample's first-scandal bin, build gvar ---- */
.         use `binpanel', clear
  5.         if "`sample'" == "pa" {
  6.                 merge m:1 country using `pa_dates', keep(1 3) nogenerate
  7.                 rename fs_pa first_scandal_date
  8.         }
  9.         else {
 10.                 merge m:1 country using `na_dates', keep(1 3) nogenerate
 11.                 rename fs_na first_scandal_date
 12.         }
 13.         format first_scandal_date %td
 14. 
.         gen byte ever_treated = !missing(first_scandal_date)
 15.         gen long first_scandal_bin = ///
>                 floor((first_scandal_date - `anchor') / `BIN') + 1 if ever_tr
> eated
 16. 
.         /* keep treated countries (full trajectory) + clean never-any-scandal
>            controls; drop countries whose only scandals are of the OTHER type
>  */
.         keep if ever_treated == 1 | ever_any_scandal == 0
 17. 
.         /* Callaway-Sant'Anna group variable: cohort bin, 0 for never-treated
>  */
.         gen long gvar = cond(ever_treated == 1, first_scandal_bin, 0)
 18. 
.         xtset country_id bin_idx
 19. 
.         tempfile samp
 20.         save `samp'
 21. 
.         /* pre-initialise every table cell to missing so the write-out loop
>            never references an undefined scalar (Stata does not short-circuit
> ) */
.         foreach method in reg ipw dripw {
 22.         foreach tg in v nv {
 23.         foreach T in 60 90 120 {
 24.                 scalar B_`method'_`tg'_`T'  = .
 25.                 scalar S_`method'_`tg'_`T'  = .
 26.                 scalar PP_`method'_`tg'_`T' = .
 27.         }
 28.         }
 29.         }
 30. 
.         /* store static/pretrend numbers keyed by method x outcome x window *
> /
.         foreach oc in mm_violent mm_nonviolent {
 31. 
.                 local tag = cond("`oc'" == "mm_violent", "v", "nv")
 32. 
.                 use `samp', clear
 33. 
.                 /* baseline pre-scandal protest intensity (country-level, tim
> e-
>                    invariant): mean of the outcome over each country's PRE-tr
> eatment
>                    bins (all bins for never-treated).  This is the analog of 
> Acemoglu
>                    et al.'s conditioning on recent GDP. */
.                 gen double _pre = `oc' if (gvar == 0 | bin_idx < gvar)
 34.                 bysort country_id: egen double basecov = mean(_pre)
 35.                 drop _pre
 36. 
.                 foreach method in reg ipw dripw {
 37. 
.                         di as result "--- CS-DiD `method' : `oc' [`sample'] -
> --"
 38.                         capture noisily csdid `oc' basecov, ///
>                                 ivar(country_id) time(bin_idx) gvar(gvar) met
> hod(`method')
 39.                         if _rc {
 40.                                 display in red "csdid failed: `method' `oc
> ' [`sample'] (rc=`_rc')"
 41.                                 continue
 42.                         }
 43. 
.                         foreach T in 60 90 120 {
 44.                                 local nbin = `T' / `BIN'
 45. 
.                                 /* aggregate to an event study restricted to 
> the +-T window;
>                                    csdid_estat returns the table in r(table),
>  with columns
>                                    Tm# / Tp# (event time) plus Pre_avg / Post
> _avg. */
.                                 capture noisily estat event, window(-`nbin' `
> =`nbin'-1')
 46.                                 if _rc continue
 47.                                 matrix rt = r(table)
 48.                                 local cols : colnames rt
 49. 
.                                 /* windowed post ATT + its two-sided p */
.                                 local jp = colnumb(rt, "Post_avg")
 50.                                 local att = rt[1, `jp']
 51.                                 local ase = rt[2, `jp']
 52.                                 /* average pre (placebo) ATT + its p = fla
> t-pretrend check */
.                                 local jm = colnumb(rt, "Pre_avg")
 53.                                 local pre  = rt[1, `jm']
 54.                                 local pse  = rt[2, `jm']
 55.                                 local pp   = 2 * normal(-abs(`pre' / `pse'
> ))
 56. 
.                                 scalar B_`method'_`tag'_`T'  = `att'
 57.                                 scalar S_`method'_`tag'_`T'  = `ase'
 58.                                 scalar PP_`method'_`tag'_`T' = `pp'
 59. 
.                                 /* store the full lead/lag path (violent only
> ) for the figure */
.                                 if "`oc'" == "mm_violent" {
 60.                                         forvalues k = `nbin'(-1)2 {
 61.                                                 local j = colnumb(rt, "Tm`
> k'")
 62.                                                 if `j' < . {
 63.                                                         post `P' ("`sample
> '") (`T') ("`method'") ///
>                                                                 (-`k') (-`k' 
> * `BIN') (rt[1,`j']) (rt[2,`j'])
 64.                                                 }
 65.                                         }
 66.                                         /* reference bin -1 pinned to 0 */
.                                         post `P' ("`sample'") (`T') ("`method
> '") ///
>                                                 (-1) (-1 * `BIN') (0) (0)
 67.                                         forvalues k = 0/`=`nbin'-1' {
 68.                                                 local j = colnumb(rt, "Tp`
> k'")
 69.                                                 if `j' < . {
 70.                                                         post `P' ("`sample
> '") (`T') ("`method'") ///
>                                                                 (`k') (`k' * 
> `BIN') (rt[1,`j']) (rt[2,`j'])
 71.                                                 }
 72.                                         }
 73.                                 }
 74.                         }
 75.                 }
 76.         }
 77. 
.         /* ---------- compact per-sample table (Acemoglu Table 5 style) -----
> -----
>            rows = the three CS estimators; columns = Violent / Non-violent, e
> ach at
>            +-60/90/120; then a pre-trend p-value block. ---------- */
.         capture file close _tbl
 78.         file open _tbl using "${tabout}/did_cs_main_`sample'.tex", write r
> eplace
 79.         file write _tbl "{" _n
 80.         file write _tbl "\def\sym#1{\ifmmode^{#1}\else\(^{#1}\)\fi}" _n
 81.         file write _tbl "\begin{tabular}{l*{6}{c}}" _n
 82.         file write _tbl "\toprule" _n
 83.         file write _tbl " & \multicolumn{3}{c}{Violent Protests} & \multic
> olumn{3}{c}{Non-violent Protests} \\" _n
 84.         file write _tbl "\cmidrule(lr){2-4}\cmidrule(lr){5-7}" _n
 85.         file write _tbl " & \ensuremath{\pm 60} & \ensuremath{\pm 90} & \e
> nsuremath{\pm 120} & \ensuremath{\pm 60} & \ensuremath{\pm 90} & \ensuremath{
> \pm 120} \\" _n
 86.         file write _tbl "\midrule" _n
 87.         file write _tbl "\multicolumn{7}{l}{\textit{Panel A: windowed ATT 
> (average post-scandal effect)}}\\" _n
 88.         foreach method in reg ipw dripw {
 89.                 if "`method'" == "reg"   local rl "Regression adj."
 90.                 if "`method'" == "ipw"   local rl "IPW"
 91.                 if "`method'" == "dripw" local rl "Doubly robust"
 92.                 local brow "`rl'"
 93.                 local srow "            "
 94.                 foreach tag in v nv {
 95.                 foreach T in 60 90 120 {
 96.                         local b = B_`method'_`tag'_`T'
 97.                         local s = S_`method'_`tag'_`T'
 98.                         if missing(`b') | missing(`s') | `s' <= 0 {
 99.                                 local brow "`brow' & --"
100.                                 local srow "`srow' & "
101.                         }
102.                         else {
103.                                 local pv = 2*normal(-abs(`b'/`s'))
104.                                 local st = ""
105.                                 if `pv' < 0.10 local st = "*"
106.                                 if `pv' < 0.05 local st = "**"
107.                                 if `pv' < 0.01 local st = "***"
108.                                 if "`st'" != "" local bcell = string(`b',"
> %5.3f") + "\sym{`st'}"
109.                                 else            local bcell = string(`b',"
> %5.3f")
110.                                 local scell = "(" + string(`s',"%5.3f") + 
> ")"
111.                                 local brow "`brow' & `bcell'"
112.                                 local srow "`srow' & `scell'"
113.                         }
114.                 }
115.                 }
116.                 file write _tbl "`brow' \\" _n
117.                 file write _tbl "`srow' \\" _n
118.         }
119.         file write _tbl "\midrule" _n
120.         file write _tbl "\multicolumn{7}{l}{\textit{Panel B: pre-trend tes
> t, \(p\)-value (avg.\ pre-scandal placebo ATT \(=0\))}}\\" _n
121.         foreach method in reg ipw dripw {
122.                 if "`method'" == "reg"   local rl "Regression adj."
123.                 if "`method'" == "ipw"   local rl "IPW"
124.                 if "`method'" == "dripw" local rl "Doubly robust"
125.                 local prow "`rl'"
126.                 foreach tag in v nv {
127.                 foreach T in 60 90 120 {
128.                         local p = PP_`method'_`tag'_`T'
129.                         if missing(`p') {
130.                                 local prow "`prow' & --"
131.                         }
132.                         else {
133.                                 local pcell = string(`p',"%4.3f")
134.                                 local prow "`prow' & `pcell'"
135.                         }
136.                 }
137.                 }
138.                 file write _tbl "`prow' \\" _n
139.         }
140.         file write _tbl "\bottomrule" _n
141.         file write _tbl "\end{tabular}" _n
142.         file write _tbl "}" _n
143.         file close _tbl
144.         display in green "did_cs_main_`sample'.tex written"
145. }


