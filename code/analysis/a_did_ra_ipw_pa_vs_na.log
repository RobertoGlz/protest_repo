. /* postfile for the violent-outcome event-study paths (all four specs) */
. tempname P

. tempfile plotdata

. postfile `P' str4 sample int T str6 spec int etime double days ///
>         double b double se using "`plotdata'", replace
(file C:\Users\rob98\AppData\Local\Temp\ST_b570_000007.tmp not found)

. 
. /* ============================================================
>    SAMPLE LOOP
>    ============================================================ */
. foreach sample in pa na {
  2. 
.         di as result _newline _newline ///
>                 "============================================================
> ====="  _n ///
>                 "   RA / IPW / DR event study  --  sample=`sample'"          
>          _n ///
>                 "============================================================
> ====="
  3. 
.         use `binpanel', clear
  4.         if "`sample'" == "pa" {
  5.                 merge m:1 country using `pa_dates', keep(1 3) nogenerate
  6.                 rename fs_pa first_scandal_date
  7.         }
  8.         else {
  9.                 merge m:1 country using `na_dates', keep(1 3) nogenerate
 10.                 rename fs_na first_scandal_date
 11.         }
 12.         format first_scandal_date %td
 13. 
.         gen byte ever_treated = !missing(first_scandal_date)
 14.         gen long first_scandal_bin = ///
>                 floor((first_scandal_date - `anchor') / `BIN') + 1 if ever_tr
> eated
 15. 
.         /* clean controls: drop never-treated country-YEARS with any scandal 
> */
.         drop if ever_treated == 0 & cy_any_scandal == 1
 16. 
.         xtset country_id bin_idx
 17.         gen long etime = bin_idx - first_scandal_bin if ever_treated == 1
 18. 
.         tempfile samp
 19.         save `samp'
 20. 
.         /* pre-initialise every table cell to missing so the write-out loop
>            never references an undefined scalar (Stata does not short-circuit
> ) */
.         foreach spec in none ra ipw dr {
 21.         foreach tg in v nv {
 22.         foreach T in 60 90 120 {
 23.                 scalar B_`spec'_`tg'_`T'  = .
 24.                 scalar S_`spec'_`tg'_`T'  = .
 25.                 scalar PP_`spec'_`tg'_`T' = .
 26.         }
 27.         }
 28.         }
 29. 
.         foreach oc in mm_violent mm_nonviolent {
 30. 
.                 local tag = cond("`oc'" == "mm_violent", "v", "nv")
 31. 
.                 use `samp', clear
 32. 
.                 /* ---- J lags of the outcome (computed on the full series) -
> --- */
.                 local lagvars ""
 33.                 forvalues j = 1/`J' {
 34.                         gen double Lo`j' = L`j'.`oc'
 35.                         local lagvars "`lagvars' Lo`j'"
 36.                 }
 37. 
.                 /* ---- baseline pre-scandal protest intensity (country level
> ) ---- */
.                 gen double _pre = `oc' if (ever_treated == 0 | bin_idx < firs
> t_scandal_bin)
 38.                 bysort country_id: egen double basecov = mean(_pre)
 39.                 drop _pre
 40. 
.                 /* ---- propensity of being a treated country given the basel
> ine
>                         covariate; Abadie/Sant'Anna-Zhao IPW weights ---- */
.                 preserve
 41.                         keep country_id ever_treated basecov
 42.                         duplicates drop
 43.                         capture probit ever_treated basecov
 44.                         if _rc {
 45.                                 gen double pscore = .
 46.                         }
 47.                         else {
 48.                                 predict double pscore, pr
 49.                         }
 50.                         keep country_id pscore
 51.                         tempfile ps
 52.                         save `ps'
 53.                 restore
 54.                 merge m:1 country_id using `ps', nogenerate
 55.                 replace pscore = min(max(pscore, .001), .999)
 56.                 gen double ipw = cond(ever_treated == 1, 1, ///
>                         cond(missing(pscore), 1, pscore / (1 - pscore)))
 57. 
.                 /* ---- window loop: build event dummies, run the 4 specs ---
> - */
.                 foreach T in 60 90 120 {
 58.                         local nbin = `T' / `BIN'
 59. 
.                         capture drop ev_lead* ev_lag*
 60.                         local esv ""
 61.                         local leadv ""
 62.                         local lagv ""
 63.                         forvalues k = `nbin'(-1)2 {
 64.                                 gen byte ev_lead`k' = (etime == -`k') & ev
> er_treated == 1
 65.                                 local esv   "`esv' ev_lead`k'"
 66.                                 local leadv "`leadv' ev_lead`k'"
 67.                         }
 68.                         forvalues k = 0/`=`nbin'-1' {
 69.                                 gen byte ev_lag`k' = (etime == `k') & ever
> _treated == 1
 70.                                 local esv  "`esv' ev_lag`k'"
 71.                                 local lagv "`lagv' ev_lag`k'"
 72.                         }
 73. 
.                         /* windowed post-average = (ev_lag0+...+ev_lag[nbin-1
> ]) / nbin */
.                         local postsum ""
 74.                         forvalues k = 0/`=`nbin'-1' {
 75.                                 local postsum "`postsum' + ev_lag`k'"
 76.                         }
 77.                         local postsum = subinstr("`postsum'", "+", "", 1) 
>   /* drop leading + */
 78.                         local postexpr "(`postsum') / `nbin'"
 79. 
.                         /* estimation sample: all clean-control obs + treated
>  obs inside
>                            the +-T window (far treated periods excluded, not 
> binned to 0) */
.                         gen byte insamp`T' = (ever_treated == 0) | ///
>                                 inrange(etime, -`nbin', `=`nbin'-1')
 80. 
.                         foreach spec in none ra ipw dr {
 81. 
.                                 if "`spec'" == "none" local rhs "`esv'"
 82.                                 if "`spec'" == "ra"   local rhs "`esv' `la
> gvars'"
 83.                                 if "`spec'" == "ipw"  local rhs "`esv'"
 84.                                 if "`spec'" == "dr"   local rhs "`esv' `la
> gvars'"
 85.                                 local wgt ""
 86.                                 if inlist("`spec'", "ipw", "dr") local wgt
>  "[pw=ipw]"
 87. 
.                                 capture noisily reghdfe `oc' `rhs' `wgt' if i
> nsamp`T' == 1, ///
>                                         absorb(country_id bin_idx) cluster(co
> untry_id)
 88.                                 if _rc {
 89.                                         display in red "reghdfe failed: `s
> pec' `oc' `sample' w`T'"
 90.                                         continue
 91.                                 }
 92. 
.                                 /* windowed post ATT */
.                                 capture quietly lincom `postexpr'
 93.                                 if _rc == 0 {
 94.                                         scalar B_`spec'_`tag'_`T' = r(esti
> mate)
 95.                                         scalar S_`spec'_`tag'_`T' = r(se)
 96.                                 }
 97.                                 /* joint pre-trend test on the lead coeffi
> cients */
.                                 capture quietly test `leadv'
 98.                                 if _rc == 0 scalar PP_`spec'_`tag'_`T' = r
> (p)
 99. 
.                                 /* store the event-study path (violent only) 
> for the figure */
.                                 if "`oc'" == "mm_violent" {
100.                                         forvalues k = `nbin'(-1)2 {
101.                                                 post `P' ("`sample'") (`T'
> ) ("`spec'") ///
>                                                         (-`k') (-`k' * `BIN')
>  (_b[ev_lead`k']) (_se[ev_lead`k'])
102.                                         }
103.                                         post `P' ("`sample'") (`T') ("`spe
> c'") (-1) (-1 * `BIN') (0) (0)
104.                                         forvalues k = 0/`=`nbin'-1' {
105.                                                 post `P' ("`sample'") (`T'
> ) ("`spec'") ///
>                                                         (`k') (`k' * `BIN') (
> _b[ev_lag`k']) (_se[ev_lag`k'])
106.                                         }
107.                                 }
108.                         }
109.                         drop insamp`T'
110.                 }
111.         }
112. 
.         /* ---------- compact per-sample table ---------- */
.         capture file close _tbl
113.         file open _tbl using "${tabout}/did_ra_main_`sample'.tex", write r
> eplace
114.         file write _tbl "{" _n
115.         file write _tbl "\def\sym#1{\ifmmode^{#1}\else\(^{#1}\)\fi}" _n
116.         file write _tbl "\begin{tabular}{l*{6}{c}}" _n
117.         file write _tbl "\toprule" _n
118.         file write _tbl " & \multicolumn{3}{c}{Violent Protests} & \multic
> olumn{3}{c}{Non-violent Protests} \\" _n
119.         file write _tbl "\cmidrule(lr){2-4}\cmidrule(lr){5-7}" _n
120.         file write _tbl " & \ensuremath{\pm 60} & \ensuremath{\pm 90} & \e
> nsuremath{\pm 120} & \ensuremath{\pm 60} & \ensuremath{\pm 90} & \ensuremath{
> \pm 120} \\" _n
121.         file write _tbl "\midrule" _n
122.         file write _tbl "\multicolumn{7}{l}{\textit{Panel A: windowed ATT 
> (average post-scandal effect)}}\\" _n
123.         foreach spec in none ra ipw dr {
124.                 if "`spec'" == "none" local rl "No adjustment"
125.                 if "`spec'" == "ra"   local rl "Regression adj."
126.                 if "`spec'" == "ipw"  local rl "IPW"
127.                 if "`spec'" == "dr"   local rl "Doubly robust"
128.                 local brow "`rl'"
129.                 local srow "            "
130.                 foreach tag in v nv {
131.                 foreach T in 60 90 120 {
132.                         if missing(B_`spec'_`tag'_`T') | S_`spec'_`tag'_`T
> ' <= 0 {
133.                                 local brow "`brow' & --"
134.                                 local srow "`srow' & "
135.                         }
136.                         else {
137.                                 local b = B_`spec'_`tag'_`T'
138.                                 local s = S_`spec'_`tag'_`T'
139.                                 local pv = 2*normal(-abs(`b'/`s'))
140.                                 local st = ""
141.                                 if `pv' < 0.10 local st = "*"
142.                                 if `pv' < 0.05 local st = "**"
143.                                 if `pv' < 0.01 local st = "***"
144.                                 if "`st'" != "" local bcell = string(`b',"
> %5.3f") + "\sym{`st'}"
145.                                 else            local bcell = string(`b',"
> %5.3f")
146.                                 local scell = "(" + string(`s',"%5.3f") + 
> ")"
147.                                 local brow "`brow' & `bcell'"
148.                                 local srow "`srow' & `scell'"
149.                         }
150.                 }
151.                 }
152.                 file write _tbl "`brow' \\" _n
153.                 file write _tbl "`srow' \\" _n
154.         }
155.         file write _tbl "\midrule" _n
156.         file write _tbl "\multicolumn{7}{l}{\textit{Panel B: pre-trend tes
> t, \(p\)-value (joint: all lead coefficients \(=0\))}}\\" _n
157.         foreach spec in none ra ipw dr {
158.                 if "`spec'" == "none" local rl "No adjustment"
159.                 if "`spec'" == "ra"   local rl "Regression adj."
160.                 if "`spec'" == "ipw"  local rl "IPW"
161.                 if "`spec'" == "dr"   local rl "Doubly robust"
162.                 local prow "`rl'"
163.                 foreach tag in v nv {
164.                 foreach T in 60 90 120 {
165.                         if missing(PP_`spec'_`tag'_`T') {
166.                                 local prow "`prow' & --"
167.                         }
168.                         else {
169.                                 local pcell = string(PP_`spec'_`tag'_`T', 
> "%4.3f")
170.                                 local prow "`prow' & `pcell'"
171.                         }
172.                 }
173.                 }
174.                 file write _tbl "`prow' \\" _n
175.         }
176.         file write _tbl "\bottomrule" _n
177.         file write _tbl "\end{tabular}" _n
178.         file write _tbl "}" _n
179.         file close _tbl
180.         display in green "did_ra_main_`sample'.tex written"
181. 
.         /* clear this sample's stored scalars before the next sample */
.         capture scalar drop _all
182. }


