. /* helper: right-edge x labels */
. capture program drop _xlabs

. program define _xlabs, rclass
  1.         args nb B
  2.         local labday = 15
  3.         if `B' == 15 & `=`nb'*`B'' >= 90 local labday = 30
  4.         local xlabs ""
  5.         forvalues bi = -`nb'/`=`nb'-1' {
  6.                 if `bi' < 0 local d = `bi' * `B'
  7.                 else        local d = (`bi' + 1) * `B'
  8.                 if mod(`d', `labday') == 0 local xlabs "`xlabs' `d'"
  9.         }
 10.         return local xlabs "`xlabs'"
 11. end

. 
. /* ============================================================
>    PART 1 - POOLED, conditioning on K daily lags of the outcome
>    ============================================================ */
. foreach T in 30 60 90 120 {
  2.         local nb = `T' / `B'
  3. 
.         local esvars ""
  4.         forvalues j = `nb'(-1)2 {
  5.                 local esvars "`esvars' pa_m`j' na_m`j'"
  6.         }
  7.         forvalues j = 1/`nb' {
  8.                 local esvars "`esvars' pa_p`j' na_p`j'"
  9.         }
 10. 
.         foreach outcome in num_violent_MM num_peaceful_MM {
 11. 
.                 use `base', clear
 12.                 /* daily lags of THIS outcome (within scandal), then restr
> ict window */
.                 local lagvars ""
 13.                 forvalues j = 1/`K' {
 14.                         gen double Lo`j' = L`j'.`outcome'
 15.                         local lagvars "`lagvars' Lo`j'"
 16.                 }
 17.                 keep if year >= `firstyear' & abs(window) <= `T'
 18.                 gen int ebin = .
 19.                 replace ebin =  floor(window / `B') + 1          if window
>  >= 0
 20.                 replace ebin = -(floor((-window - 1) / `B') + 1) if window
>  <  0
 21.                 forvalues j = 2/`nb' {
 22.                         gen byte pa_m`j' = (ebin == -`j') & in_pa
 23.                         gen byte na_m`j' = (ebin == -`j') & in_na
 24.                 }
 25.                 forvalues j = 1/`nb' {
 26.                         gen byte pa_p`j' = (ebin ==  `j') & in_pa
 27.                         gen byte na_p`j' = (ebin ==  `j') & in_na
 28.                 }
 29.                 quietly reghdfe `outcome' `esvars' `lagvars', ///
>                         absorb(month day auxvar) cluster(group_cluster)
 30. 
.                 _xlabs `nb' `B'
 31.                 local xlabs "`r(xlabs)'"
 32.                 local xpad   = 0.6 * `B'
 33.                 local xlo_ax = -`nb' * `B' - `xpad'
 34.                 local xhi_ax =  `nb' * `B' + `xpad'
 35. 
.                 local nrows = 2 * `nb'
 36.                 matrix M = J(`nrows', 5, .)
 37.                 matrix colnames M = day bpa sepa bna sena
 38.                 local row = 0
 39.                 forvalues bi = -`nb'/`=`nb'-1' {
 40.                         local ++row
 41.                         matrix M[`row', 1] = `bi' * `B'
 42.                         if `bi' == -1 {
 43.                                 matrix M[`row', 2] = 0
 44.                                 matrix M[`row', 3] = 0
 45.                                 matrix M[`row', 4] = 0
 46.                                 matrix M[`row', 5] = 0
 47.                         }
 48.                         else if `bi' <= -2 {
 49.                                 local jj = -`bi'
 50.                                 matrix M[`row', 2] = _b[pa_m`jj']
 51.                                 matrix M[`row', 3] = _se[pa_m`jj']
 52.                                 matrix M[`row', 4] = _b[na_m`jj']
 53.                                 matrix M[`row', 5] = _se[na_m`jj']
 54.                         }
 55.                         else {
 56.                                 local jj = `bi' + 1
 57.                                 matrix M[`row', 2] = _b[pa_p`jj']
 58.                                 matrix M[`row', 3] = _se[pa_p`jj']
 59.                                 matrix M[`row', 4] = _b[na_p`jj']
 60.                                 matrix M[`row', 5] = _se[na_p`jj']
 61.                         }
 62.                 }
 63. 
.                 preserve
 64.                         clear
 65.                         svmat M, names(col)
 66.                         replace day = day + `B' if day >= 0
 67.                         gen ci_lo_pa = bpa - `zcrit'*sepa
 68.                         gen ci_hi_pa = bpa + `zcrit'*sepa
 69.                         gen ci_lo_na = bna - `zcrit'*sena
 70.                         gen ci_hi_na = bna + `zcrit'*sena
 71.                         gen double day_pa = day - 0.12*`B'
 72.                         gen double day_na = day + 0.12*`B'
 73. 
.                         twoway (rspike ci_lo_pa ci_hi_pa day_pa, lcolor(navy)
>  lwidth(medthick)) ///
>                                (scatter bpa day_pa, mcolor(navy) msymbol(O) m
> size(medium)) ///
>                                (rspike ci_lo_na ci_hi_na day_na, lcolor(cranb
> erry) lwidth(medthick)) ///
>                                (scatter bna day_na, mcolor(cranberry) msymbol
> (D) msize(medium)), ///
>                                 xline(0, lcolor(black%10) lwidth(vvthick) lpa
> ttern(solid)) ///
>                                 yline(0, lpattern(dash) lcolor(black)) ///
>                                 ytitle("Effect on protests (lag-adjusted)", s
> ize(medium)) ///
>                                 ylabel(, labsize(large) format(%5.3fc) angle(
> 0)) ///
>                                 xtitle("Days since scandal", size(large)) ///
>                                 xscale(range(`xlo_ax' `xhi_ax')) ///
>                                 xlabel(`xlabs', labsize(large)) ///
>                                 legend(order(2 "Apex" 4 "Non-Apex") rows(1) s
> ize(medium) ///
>                                         position(6) region(lcolor(none))) ///
>                                 graphregion(color(white) fcolor(white)) schem
> e(s2color)
 74.                         graph export ///
>                                 "${figout}/es_pooled_`outcome'_w`T'_b`B'_ols_
> `ci_level'ci_ra.pdf", ///
>                                 replace
 75.                 restore
 76.         }
 77. }
