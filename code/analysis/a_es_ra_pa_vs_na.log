. /* ============================================================
>    PART 2 - SUBSAMPLE (pa / na), conditioning on K daily lags
>    ============================================================ */
. foreach T in 30 60 90 120 {
  2.         local nb = `T' / `B'
  3. 
.         local esvars ""
  4.         forvalues j = `nb'(-1)2 {
  5.                 local esvars "`esvars' ebin_m`j'"
  6.         }
  7.         forvalues j = 1/`nb' {
  8.                 local esvars "`esvars' ebin_p`j'"
  9.         }
 10. 
.         foreach sample in pa na {
 11.         foreach outcome in num_violent_MM num_peaceful_MM {
 12. 
.                 use `base', clear
 13.                 local lagvars ""
 14.                 forvalues j = 1/`K' {
 15.                         gen double Lo`j' = L`j'.`outcome'
 16.                         local lagvars "`lagvars' Lo`j'"
 17.                 }
 18.                 gen int ebin = .
 19.                 replace ebin =  floor(window / `B') + 1          if window
>  >= 0
