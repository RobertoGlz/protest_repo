. do a_sup_pres_plus_apex.do 

. /* --------------------------------------------------------------------------
> --
>    Project: Apex Corruption protests paper - SUPPLEMENTARY MATERIALS
> 
>    Code author: Roberto Gonzalez
>    Date: 2026-07-02
> 
>    Objective:
>      Version of Table 1 (main text) restricted to scandals where the
>      implicated official is a PRESIDENT or an "OTHER APEX" official
>      (Governors + Supreme Court Justices).
> 
>      Classification (v2 partition; see per_scandal_effects_apex_v2.do):
>         President   <=> scandals_classified.csv position == "president"
>         Other Apex  <=> position == "governor"
>                         OR (position == "sc_judge_congressman"
>                             AND id in the SC-Judge set below)
>         Other Non-Apex is the residual (dropped in this table).
> 
>      SC-Judge IDs inside the lumped "sc_judge_congressman" code (as of
>      2026-06-27): "202", "NEW26", "NEW30", "332", "NEW23".
> 
>      Specification identical to a_reg_violent_peaceful_panels.do.
> 
>    Inputs:
>      - ${datfin}/protests_scandals_30days_v3.dta
>      - ${datfin}/scandals_classified.csv
>      - ${progdir}/define_panelcombine.do
> 
>    Outputs (under ${work}/results/tables/):
>      - sup_pres_plus_apex_ols_temp.tex, _poi_temp.tex  (intermediate)
>      - sup_pres_plus_apex_table.tex                    (final)
> ---------------------------------------------------------------------------- 
> */
. 
. set more off

. clear all

. 
. if "`c(username)'" == "Diego" {
.         gl identity "D:/Documents/Dropbox"
. }

. if "`c(username)'" == "dtocre" {
.         gl identity "C:/Users/dtocre/Dropbox"
. }

. if "`c(username)'" == "lalov" {
.         gl identity "C:/Users/lalov/ITAM Seira Research Dropbox/Eduardo River
> a"
. }

. if "`c(username)'" == "Rob_9" {
.         global identity "C:/Users/Rob_9/Dropbox"
. }

. if "`c(username)'" == "rob98" {
.         global identity "~/Dropbox"
. }

. 
. global path    "${identity}/Corrupcion/WORKING FOLDER/Event Study - Scandals"

. global datfin  "${path}/Data/final"

. global work    "${identity}/Corrupcion/Protest_Work"

. global tables  "${identity}/Corrupcion/protest_repo/paper/tables"

. global progdir "${identity}/Corrupcion/protest_repo/code/programs"

. 
. do "${progdir}/define_panelcombine.do"

. /* --------------------------------------------------------------------------
> --
>    Project: Apex corruption protests paper
> 
>    Code author: steveofconnell (original)
>    Modifications: Roberto Gonzalez
> 
>    Objective: Define a panelcombine program that handles booktabs rules
>               rather than hlines. Source the program at the top of any
>               analysis do-file that builds a multi-panel table.
> 
>    Source of the original program:
>      https://raw.githubusercontent.com/steveofconnell/PanelCombine/master/Pan
> elCombine.do
>    Copied verbatim from the religion_project_repo project's
>      code/programs/define_panelcombine.do
>    so this project does not depend on a sibling repository at build time.
> ---------------------------------------------------------------------------- 
> */
. 
. cap prog drop panelcombine

. prog define panelcombine
  1. qui {
  2. syntax, use(str asis) paneltitles(str asis) columncount(integer) save(str)
>  [CLEANup]
  3. preserve
  4. 
. tokenize `"`paneltitles'"'
  5. //read in loop
. local num 1
  6. while "``num''"~="" {
  7. local panel`num'title="``num''"
  8. local num=`num'+1
  9. }
 10. 
. 
. tokenize `"`use'"'
 11. //read in loop
. local num 1
 12. while `"``num''"'~="" {
 13. local filepath `"``num''"'
 14. tempfile temp`num'
 15. insheet using `"`filepath'"', clear
 16. save `temp`num''
 17. local max = `num'
 18. local num=`num'+1
 19. }
 20. 
. //conditional processing loop
. tokenize `"`use'"'
 21. local num 1
 22. while `"``num''"'~="" {
 23. local panellabel : word `num' of `c(ALPHA)'
 24. use `temp`num'', clear
 25.         if `num'==1 { //process first panel -- clip bottom
 26.         drop if strpos(v1,"Note:")>0 | strpos(v1,"in parentheses")>0 | str
> pos(v1,"p<0")>0
 27.         drop if v1=="\end{tabular}" | v1=="}"
 28.         /* Replace ONLY the first occurrence of \midrule with the Panel A
>            header. Using cumulative-sum-of-flag is robust to the row
>            position changing because of mgroups, multi-row column
>            headers, etc. */
.         gen byte _is_mid = (v1 == "\midrule")
 29.         gen long _midnum = sum(_is_mid)
 30.         replace v1 = "\midrule \multicolumn{`columncount'}{l}{\textbf{\tex
> tit{Panel `panellabel': `panel1title'}}} \\" if _is_mid == 1 & _midnum == 1
 31.         drop _is_mid _midnum
 32.         replace v1 = "\midrule" if v1=="\bottomrule" & _n>4 //this is inte
> nded to replace the bottom double line; more robust condition probably exists
 33.         }
 34.         else if `num'==`max' { //process final panel -- clip top
 35.         //process header to drop everything until first hline
.         g temp = (v1 == "\midrule")
 36.         replace temp = temp+temp[_n-1] if _n>1
 37.         drop if temp==0
 38.         drop temp
 39. 
.         replace v1 = " \multicolumn{`columncount'}{l}{\textbf{\textit{Panel `
> panellabel': `panel`num'title'}}} \\" if _n==1
 40.         }
 41.         else { //process middle panels -- clip top and bottom
 42.         //process header to drop everything until first hline
.         g temp = (v1 == "\midrule")
 43.         replace temp = temp+temp[_n-1] if _n>1
 44.         drop if temp==0
 45.         drop temp
 46. 
.         replace v1 = " \multicolumn{`columncount'}{l}{\textbf{\textit{Panel `
> panellabel': `panel`num'title'}}} \\" if _n==1
 47.         drop if strpos(v1,"Note:")>0 | strpos(v1,"in parentheses")>0 | str
> pos(v1,"p<0")>0
 48.         drop if v1=="\end{tabular}" | v1=="}"
 49.         replace v1 = "\bottomrule" if v1=="\bottomrule\bottomrule"
 50.         }
 51.         save `temp`num'', replace
 52. local num=`num'+1
 53. }
 54. 
. use `temp1',clear
 55. local num 2
 56. while "``num''"~="" {
 57. append using `temp`num''
 58. local num=`num'+1
 59. }
 60. 
. outsheet using `save', noname replace noquote
 61. 
. 
.         if "`cleanup'"!="" { //erasure loop
 62.         tokenize `"`use'"'
 63.         local num 1
 64.                 while `"``num''"'~="" {
 65.                 local filepath `"``num''"'
 66.                 erase `"`filepath'"'
 67.                 local num=`num'+1
 68.                 }
 69.         }
 70. 
. restore
 71. }
 72. end

. 
end of do-file

. 
. import delimited using "${datfin}/scandals_classified.csv", ///
>         clear varnames(1) bindquotes(strict)
(encoding automatically selected: UTF-8)
(7 vars, 190 obs)

. keep id country position

. tempfile cls

. save `cls'
file C:\Users\rob98\AppData\Local\Temp\ST_be28_000001.tmp saved as .dta
    format

. 
. use "${datfin}/protests_scandals_30days_v3", clear

. drop if country == "Venezuela"
(3,374 observations deleted)

. 
. merge m:1 id country using `cls', keep(1 3) generate(_mclass)

    Result                      Number of obs
    -----------------------------------------
    Not matched                             0
    Matched                            42,657  (_mclass==3)
    -----------------------------------------

. 
. /* --- Apex partition v2: keep President OR Other Apex, drop rest --- */
. gen byte _keep = 0

. replace _keep = 1 if position == "president"
(10,845 real changes made)

. replace _keep = 1 if position == "governor"
(3,615 real changes made)

. replace _keep = 1 if position == "sc_judge_congressman" & ///
>         inlist(id, "202", "NEW26", "NEW30", "332")
(964 real changes made)

. keep if _keep == 1
(27,233 observations deleted)

. drop _keep

. 
. /* --------------- Share outcomes --------------- */
. gen double share_violent  = num_violent_MM  / num_protests_MM if num_protests
> _MM > 0
(14,392 missing values generated)

. gen double share_peaceful = num_peaceful_MM / num_protests_MM if num_protests
> _MM > 0
(14,392 missing values generated)

. replace    share_violent  = 0 if num_protests_MM == 0
(14,392 real changes made)

. replace    share_peaceful = 0 if num_protests_MM == 0
(14,392 real changes made)

. 
. egen grupo_dias = group(s_lag30 s_lag60 s_lag90 s_lag120 ///
>                         s_lead30 s_lead60 s_lead90 s_lead120)

. 
. global fe1      "i.country_id#i.year"

. global CLUSTER2 "cluster i.country_id#i.year#i.grupo_dias"

. 
. local firstyear = 2008

. local ols_out   "num_violent_MM num_peaceful_MM num_violent_MM num_peaceful_M
> M share_violent share_peaceful share_violent share_peaceful"

. local ols_win   "30 30 120 120 30 30 120 120"

. local ols_n : word count `ols_out'

. local poi_out   "num_violent_MM num_peaceful_MM num_violent_MM num_peaceful_M
> M"

. local poi_win   "30 30 120 120"

. local poi_n : word count `poi_out'

. 
. /* PANEL A: OLS on all 8 outcomes */
. eststo clear

. forvalues k = 1/`ols_n' {
  2.         local outcome : word `k' of `ols_out'
  3.         local window  : word `k' of `ols_win'
  4.         local bin_size = cond(`window' == 30, 6, 30)
  5. 
.         if `window' == 30 {
  6.                 eststo m`k': reghdfe `outcome' post i.month i.day ///
>                         if year >= `firstyear' & abs(window) <= 30, ///
>                         absorb($fe1) vce($CLUSTER2)
  7.         }
  8.         else {
  9.                 eststo m`k': reghdfe `outcome' post i.month i.day ///
>                         if year >= `firstyear', ///
>                         absorb($fe1) vce($CLUSTER2)
 10.         }
 11.         quietly summarize `outcome' if e(sample) ///
>                 & window >= -`bin_size' & window <= -1
 12.         estadd scalar baseline = r(mean)
 13.         quietly levelsof id if e(sample) == 1
 14.         estadd scalar num_scandals = r(r)
 15. }
