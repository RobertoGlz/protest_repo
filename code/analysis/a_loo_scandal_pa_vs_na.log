. /* ============================================================
>    PASS 1 - run each LOO, store estimates
>    ============================================================ */
. tempname A

. tempfile allres

. postfile `A' str8 grp str8 split int sid double est double se str48 lab ///
>         using "`allres'", replace
(file C:\Users\rob98\AppData\Local\Temp\ST_bc98_000007.tmp not found)

. 
. foreach grp in apex nonapex pres oa ona high med low {
  2.         grpset "`grp'"
  3.         local IF "year >= `firstyear' & abs(window) <= `WIN' & ${g_samp}"
  4. 
.         use `base', clear
  5.         keep if `IF' & ${g_mem}
  6.         keep country id scanyear
  7.         duplicates drop
  8.         /* flag country-year combinations that appear more than once WITHI
> N this
>            group, so we can disambiguate them by scandal id in the label */
.         bysort country scanyear: gen byte _ndup = _N
  9.         sort country id
 10.         local NS = _N
 11.         forvalues i = 1/`NS' {
 12.                 local ctry`i' = country[`i']
 13.                 local idv`i'  = id[`i']
 14.                 local yr`i'   = scanyear[`i']
 15.                 local dup`i'  = _ndup[`i']
 16.         }
 17.         di as result "Group `grp' [${g_split}]: `NS' scandals..."
 18. 
.         use `base', clear
 19.         forvalues i = 1/`NS' {
 20.                 local c "`ctry`i''"
 21.                 local s "`idv`i''"
 22.                 capture reghdfe `OUTCOME' ${g_rhs} i.month i.day ///
>                         if `IF' & !(country == "`c'" & id == "`s'"), ///
>                         absorb(i.country_id#i.year) vce(cluster i.country_id#
> i.year#i.grupo_dias)
 23.                 if _rc continue
 24.                 if `dup`i'' > 1 local lab "`ctry`i'' - `yr`i'' (`idv`i'')"
 25.                 else            local lab "`ctry`i'' - `yr`i''"
 26.                 post `A' ("`grp'") ("${g_split}") (`i') (_b[${g_coef}]) (_
> se[${g_coef}]) ("`lab'")
 27.         }
 28. }
