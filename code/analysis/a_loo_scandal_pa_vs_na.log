. /* ---- common y-range per split (constant within split), in scalars ---- */
. use "`allres'", clear

. gen double lo = est - `zcrit' * se

. gen double hi = est + `zcrit' * se

. foreach sp in sc hier demo {
  2.         quietly summarize lo if split == "`sp'"
  3.         scalar rmin = r(min)
  4.         quietly summarize hi if split == "`sp'"
  5.         scalar rmax = r(max)
  6.         scalar rpad = 0.05 * (rmax - rmin)
  7.         scalar ylo_`sp' = rmin - rpad
  8.         scalar yhi_`sp' = rmax + rpad
  9.         /* nice label step spanning the full range (~7 ticks) */
.         scalar rraw = (yhi_`sp' - ylo_`sp') / 7
 10.         scalar rmag = 10 ^ floor(log10(rraw))
 11.         scalar rmul = rraw / rmag
 12.         if      rmul < 1.5 scalar step_`sp' = 1  * rmag
 13.         else if rmul < 3.5 scalar step_`sp' = 2  * rmag
 14.         else if rmul < 7.5 scalar step_`sp' = 5  * rmag
 15.         else               scalar step_`sp' = 10 * rmag
 16.         scalar lolab_`sp' = ceil(ylo_`sp' / step_`sp') * step_`sp'
 17.         scalar hilab_`sp' = floor(yhi_`sp' / step_`sp') * step_`sp'
 18. }

. 
. /* ============================================================
>    PASS 2 - plot each group with its split's common y-range
>    ============================================================ */
. /* Common FIGURE SIZE within each split: use the largest group's scandal
>    count to set ONE width for every panel in the split, so all panels share
>    an identical aspect ratio (and hence an identical visual y-scale once each
>    is displayed at the same width in the paper). */
. foreach sp in sc hier demo {
  2.         scalar nmax_`sp' = 0
  3. }

. use "`allres'", clear

. foreach grp in apex nonapex pres oa ona high med low {
  2.         grpset "`grp'"
  3.         local sp2 "${g_split}"
  4.         quietly count if grp == "`grp'"
  5.         scalar nmax_`sp2' = max(nmax_`sp2', r(N))
  6. }

. 
. foreach grp in apex nonapex pres oa ona high med low {
  2.         grpset "`grp'"
  3.         local sp "${g_split}"
  4.         scalar bfull = ${g_bf}
  5.         if "`sp'" == "sc" {
  6.                 local ylo = ylo_sc
  7.                 local yhi = yhi_sc
  8.                 local ylab = lolab_sc
  9.                 local yhib = hilab_sc
 10.                 local ystp = step_sc
 11.         }
 12.         if "`sp'" == "hier" {
 13.                 local ylo = ylo_hier
 14.                 local yhi = yhi_hier
 15.                 local ylab = lolab_hier
 16.                 local yhib = hilab_hier
 17.                 local ystp = step_hier
 18.         }
 19.         if "`sp'" == "demo" {
 20.                 local ylo = ylo_demo
 21.                 local yhi = yhi_demo
 22.                 local ylab = lolab_demo
 23.                 local yhib = hilab_demo
 24.                 local ystp = step_demo
 25.         }
 26. 
.         use "`allres'", clear
 27.         keep if grp == "`grp'"
 28.         gen double lo = est - `zcrit' * se
 29.         gen double hi = est + `zcrit' * se
 30.         gsort est
 31.         gen int rank = _n
 32.         capture label drop rlab
 33.         forvalues i = 1/`=_N' {
 34.                 local L = lab[`i']
 35.                 label define rlab `i' "`L'", add
 36.         }
 37.         label values rank rlab
 38.         /* width from the split's LARGEST group, so every panel in the spl
> it is
>            the same physical size (identical aspect ratio and visual y-scale)
>  */
.         if "`sp'" == "sc"   local nmx = nmax_sc
 39.         if "`sp'" == "hier" local nmx = nmax_hier
 40.         if "`sp'" == "demo" local nmx = nmax_demo
 41.         /* minimum width keeps a wide/short aspect so that a 3-panel split
>  (e.g.
>            the democracy terciles) fits on a single page when stacked */
.         local wd = max(13, `nmx' * 0.13)
 42. 
.         twoway (rspike lo hi rank, lcolor(gs8) lwidth(thin)) ///
>                (scatter est rank, mcolor(navy) msymbol(O) msize(small)), ///
>                 yline(0, lcolor(black%10) lwidth(vvthick) lpattern(solid)) //
> /
>                 yline(`=bfull', lcolor(red) lwidth(medthick) lpattern(solid))
>  ///
>                 yscale(range(`ylo' `yhi')) ///
>                 ylabel(`ylab'(`ystp')`yhib', angle(horizontal) format(%4.3fc)
> ) ///
>                 ytitle("${g_ytit}", size(medium)) ///
>                 xtitle("") ///
>                 xlabel(1(1)`=_N', valuelabel labsize(tiny) angle(90) nogrid) 
> ///
>                 xscale(range(0 `=_N+1')) ///
>                 legend(off) ///
>                 note("Red line: coefficient estimated on all scandals.", size
> (small)) ///
>                 graphregion(color(white) fcolor(white)) scheme(s2color) ///
>                 xsize(`wd') ysize(4.3)
 43.         graph export "${figout}/loo_scandal_beta_`grp'_violent_w`WIN'.pdf"
> , replace
 44.         display in green "loo_scandal_beta_`grp'_violent_w`WIN'.pdf writte
> n"
 45. }
