. /* ============================================================
>    PART 1 - POOLED event study (apex & non-apex jointly), de-trended
>    ============================================================ */
. foreach T in 30 60 90 120 {
  2.         local nb = `T' / `B'
  3. 
.         local esvars ""
  4.         forvalues j = `nb'(-1)2 {
  5.                 local esvars "`esvars' pa_m`j' na_m`j'"
  6.         }
  7.         forvalues j = 1/`nb' {
  8.                 local esvars "`esvars' pa_p`j' na_p`j'"
  9.         }
 10. 
.         foreach outcome in num_violent_MM num_peaceful_MM {
 11. 
.                 use `base', clear
 12.                 keep if year >= `firstyear' & abs(window) <= `T'
 13.                 gen int ebin = .
 14.                 replace ebin =  floor(window / `B') + 1          if window
>  >= 0
 15.                 replace ebin = -(floor((-window - 1) / `B') + 1) if window
>  <  0
 16.                 forvalues j = 2/`nb' {
 17.                         gen byte pa_m`j' = (ebin == -`j') & in_pa
 18.                         gen byte na_m`j' = (ebin == -`j') & in_na
 19.                 }
 20.                 forvalues j = 1/`nb' {
 21.                         gen byte pa_p`j' = (ebin ==  `j') & in_pa
 22.                         gen byte na_p`j' = (ebin ==  `j') & in_na
 23.                 }
 24.                 quietly reghdfe `outcome' `esvars', ///
>                         absorb(month day auxvar) cluster(group_cluster)
 25. 
.                 _dt pa `nb'
 26.                 matrix bcpa  = r(bc)
 27.                 matrix secpa = r(sec)
 28.                 _dt na `nb'
 29.                 matrix bcna  = r(bc)
 30.                 matrix secna = r(sec)
 31. 
.                 /* x-axis labels: right edge for post bins, gap at 0 */
.                 local labday = 15
 32.                 if `T' >= 90 local labday = 30
 33.                 local xlabs ""
 34.                 forvalues bi = -`nb'/`=`nb'-1' {
 35.                         if `bi' < 0 local d = `bi' * `B'
 36.                         else        local d = (`bi' + 1) * `B'
 37.                         if mod(`d', `labday') == 0 local xlabs "`xlabs' `d
> '"
 38.                 }
 39.                 local xpad   = 0.6 * `B'
 40.                 local xlo_ax = -`nb' * `B' - `xpad'
 41.                 local xhi_ax =  `nb' * `B' + `xpad'
 42. 
.                 preserve
 43.                         clear
 44.                         local npts = 2 * `nb'
 45.                         set obs `npts'
 46.                         gen int    ebin = _n - `nb' - 1        /* -nb .. n
> b-1 */
 47.                         gen double day  = ebin * `B'
 48.                         gen double bpa = 0
 49.                         gen double sepa = 0
 50.                         gen double bna = 0
 51.                         gen double sena = 0
 52.                         forvalues r = 1/`npts' {
 53.                                 local bin = `r' - `nb' - 1
 54.                                 if `bin' == -1 continue
 55.                                 if `bin' <= -2 local i = `nb' + `bin' + 1
 56.                                 else           local i = `nb' + `bin'
 57.                                 quietly replace bpa  = bcpa[1, `i']  in `r
> '
 58.                                 quietly replace sepa = secpa[1, `i'] in `r
> '
 59.                                 quietly replace bna  = bcna[1, `i']  in `r
> '
 60.                                 quietly replace sena = secna[1, `i'] in `r
> '
 61.                         }
 62.                         replace day = day + `B' if ebin >= 0
 63.                         gen ci_lo_pa = bpa - `zcrit' * sepa
 64.                         gen ci_hi_pa = bpa + `zcrit' * sepa
 65.                         gen ci_lo_na = bna - `zcrit' * sena
 66.                         gen ci_hi_na = bna + `zcrit' * sena
 67.                         gen double day_pa = day - 0.12 * `B'
 68.                         gen double day_na = day + 0.12 * `B'
 69. 
.                         twoway (rspike ci_lo_pa ci_hi_pa day_pa, lcolor(navy)
>  lwidth(medthick)) ///
>                                (scatter bpa day_pa, mcolor(navy) msymbol(O) m
> size(medium)) ///
>                                (rspike ci_lo_na ci_hi_na day_na, lcolor(cranb
> erry) lwidth(medthick)) ///
>                                (scatter bna day_na, mcolor(cranberry) msymbol
> (D) msize(medium)), ///
>                                 xline(0, lcolor(black%10) lwidth(vvthick) lpa
> ttern(solid)) ///
>                                 yline(0, lpattern(dash) lcolor(black)) ///
>                                 ytitle("Effect on protests (de-trended)", siz
> e(large)) ///
>                                 ylabel(, labsize(large) format(%5.3fc) angle(
> 0)) ///
>                                 xtitle("Days since scandal", size(large)) ///
>                                 xscale(range(`xlo_ax' `xhi_ax')) ///
>                                 xlabel(`xlabs', labsize(large)) ///
>                                 legend(order(2 "Apex" 4 "Non-Apex") rows(1) s
> ize(medium) ///
>                                         position(6) region(lcolor(none))) ///
>                                 graphregion(color(white) fcolor(white)) schem
> e(s2color)
 70.                         graph export ///
>                                 "${figout}/es_pooled_`outcome'_w`T'_b`B'_ols_
> `ci_level'ci_dt.pdf", ///
>                                 replace
 71.                 restore
 72.         }
 73. }
