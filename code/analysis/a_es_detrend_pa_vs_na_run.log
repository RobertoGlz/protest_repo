. /* ============================================================
>    Helper: after an event-study reghdfe, de-trend one group's path
>    (dummies named <prefix>_m<j> for leads j=2..nb, <prefix>_p<j> for
>    lags j=1..nb).  Returns, in bin order [-nb..-2, 0..nb-1], the
>    corrected coefficients r(bc) and SEs r(sec) as 1 x (2*nb-1) rows.
>    ============================================================ */
. capture program drop _dt

. program define _dt, rclass
  1.         args prefix nb
  2.         local nn = 2 * `nb' - 1
  3. 
.         /* linear pre-trend fitted through the origin on the lead bins:
>            gamma = sum_pre x_m beta_m / sum_pre x_m^2                        
> */
.         local denom = 0
  4.         local presum ""
  5.         forvalues j = `nb'(-1)2 {
  6.                 local xm = -`j' + 1
  7.                 local denom = `denom' + `xm' * `xm'
  8.                 local presum "`presum' + (`xm') * `prefix'_m`j'"
  9.         }
 10.         local presum = substr("`presum'", 4, .)   /* drop leading " + " */
 11. 
.         tempname bc sec
 12.         matrix `bc'  = J(1, `nn', 0)
 13.         matrix `sec' = J(1, `nn', 0)
 14. 
.         local i = 0
 15.         forvalues j = `nb'(-1)2 {
 16.                 local ++i
 17.                 local xk = -`j' + 1
 18.                 capture lincom `prefix'_m`j' - (`xk' / `denom') * (`presum
> ')
 19.                 if _rc == 0 {
 20.                         matrix `bc'[1, `i']  = r(estimate)
 21.                         matrix `sec'[1, `i'] = r(se)
 22.                 }
 23.         }
 24.         forvalues j = 1/`nb' {
 25.                 local ++i
 26.                 local xk = `j'
 27.                 capture lincom `prefix'_p`j' - (`xk' / `denom') * (`presum
> ')
 28.                 if _rc == 0 {
 29.                         matrix `bc'[1, `i']  = r(estimate)
 30.                         matrix `sec'[1, `i'] = r(se)
 31.                 }
 32.         }
 33.         return matrix bc  = `bc'
 34.         return matrix sec = `sec'
 35. end

