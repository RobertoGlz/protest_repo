.         /* ---------- compact per-sample table: rows = estimators, columns =
>            outcome x window (Violent / Non-violent at +-60/90/120; the
>            government-violent-response and any-protests outcomes dropped) ---
> ------- */
.         capture file close _tbl
226.         file open _tbl using "${tabout}/did_modern_stk_main_`sample'.tex",
>  write replace
227.         file write _tbl "{" _n
228.         file write _tbl "\def\sym#1{\ifmmode^{#1}\else\(^{#1}\)\fi}" _n
229.         file write _tbl "\begin{tabular}{l*{8}{c}}" _n
230.         file write _tbl "\toprule" _n
231.         file write _tbl " & \multicolumn{4}{c}{Violent Protests} & \multic
> olumn{4}{c}{Non-violent Protests} \\" _n
232.         file write _tbl "\cmidrule(lr){2-5}\cmidrule(lr){6-9}" _n
233.         file write _tbl " & \ensuremath{\pm 30} & \ensuremath{\pm 60} & \e
> nsuremath{\pm 90} & \ensuremath{\pm 120} & \ensuremath{\pm 30} & \ensuremath{
> \pm 60} & \ensuremath{\pm 90} & \ensuremath{\pm 120} \\" _n
234.         file write _tbl "\midrule" _n
235.         foreach er in ols dcdh bjs sa {
236.                 if "`er'" == "ols"  local rowlab "OLS (TWFE)"
237.                 if "`er'" == "dcdh" local rowlab "dCDH"
238.                 if "`er'" == "bjs"  local rowlab "BJS"
239.                 if "`er'" == "sa"   local rowlab "SA"
240.                 local brow "`rowlab'"
241.                 local srow "            "
242.                 foreach oc of numlist 1/2 {
243.                 foreach TT of numlist 30 60 90 120 {
244.                         local b = B_`er'_w`TT'_`oc'
245.                         local s = S_`er'_w`TT'_`oc'
246.                         if missing(`b') | missing(`s') | `s' <= 0 {
247.                                 local brow "`brow' & --"
248.                                 local srow "`srow' & "
249.                         }
250.                         else {
251.                                 local pv = 2*normal(-abs(`b'/`s'))
252.                                 local st = ""
253.                                 if `pv' < 0.10 local st = "*"
254.                                 if `pv' < 0.05 local st = "**"
255.                                 if `pv' < 0.01 local st = "***"
256.                                 if "`st'" != "" local bcell = string(`b',"
> %5.3f") + "\sym{`st'}"
257.                                 else            local bcell = string(`b',"
> %5.3f")
258.                                 local scell = "(" + string(`s',"%5.3f") + 
> ")"
259.                                 local brow "`brow' & `bcell'"
260.                                 local srow "`srow' & `scell'"
261.                         }
262.                 }
263.                 }
264.                 file write _tbl "`brow' \\" _n
265.                 file write _tbl "`srow' \\" _n
266.         }
267.         file write _tbl "\midrule" _n
268.         local nrow "Observations"
269.         foreach oc of numlist 1/2 {
270.         foreach TT of numlist 30 60 90 120 {
271.                 local ncell = trim(string(N_w`TT'_`oc', "%12.0fc"))
272.                 local nrow "`nrow' & `ncell'"
273.         }
274.         }
275.         file write _tbl "`nrow' \\" _n
276.         file write _tbl "\bottomrule" _n
277.         file write _tbl "\end{tabular}" _n
278.         file write _tbl "}" _n
279.         file close _tbl
280.         display in green "did_modern_stk_main_`sample'.tex written"
281. }


