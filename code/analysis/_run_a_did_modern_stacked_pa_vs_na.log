. /* ============================================================
>    2.  SUBSAMPLE LOOP
>    ============================================================ */
. foreach sample in pa na {
  2. 
.         di as result _newline _newline ///
>                 "============================================================
> =====" _n ///
>                 "   DID MODERN (stacked, `BIN'-day bins, +-`NBIN' bins) -- `s
> ample'" _n ///
>                 "============================================================
> ====="
  3. 
.         use `sclist_all', clear
  4.         keep if in_`sample' == 1
  5.         gen long scandal_id = _n
  6.         quietly count
  7.         local nscandals = r(N)
  8.         tempfile sclist
  9.         save `sclist'
 10.         display in yellow "Scandals to stack [`sample']: `nscandals'"
 11. 
.         foreach NBIN of numlist 2 4 6 8 {
 12.         local T = `NBIN' * `BIN'      /* event-window width in days: 60/90
> /120 */
 13. 
.         /* --- build the stacked panel: +-NBIN bins per scandal --- */
.         clear
 14.         tempfile stack
 15.         save `stack', emptyok replace
 16. 
.         forvalues s = 1/`nscandals' {
 17.                 use `sclist' in `s', clear
 18.                 local scc = country[1]
 19.                 local scb = scandal_bin[1]
 20. 
.                 use `cbin', clear
 21.                 keep if inrange(ebin, `scb'-`NBIN', `scb'+`NBIN')
 22.                 bysort country: egen _anysc = max(sc)
 23.                 keep if country == "`scc'" | _anysc == 0
 24.                 gen long stack        = `s'
 25.                 gen long etime        = ebin - `scb'
 26.                 gen byte treated_unit = (country == "`scc'")
 27.                 drop _anysc
 28.                 append using `stack'
 29.                 save `stack', replace
 30.         }
 31. 
.         use `stack', clear
 32.         egen long unit_id = group(stack country)
 33.         gen byte D = treated_unit == 1 & etime >= 0
 34.         gen long cohort = 0 if treated_unit == 1
 35.         gen byte I_never_treated = (treated_unit == 0)
 36. 
.         di as result "=== Stacked country x `BIN'-day-bin panel [`sample'] ==
> ="
 37.         count
 38.         quietly levelsof stack
 39.         di "Stacks (scandals): " r(r)
 40. 
.         /* event-study dummies: bins -NBIN..-2 and 0..NBIN-1; bin -1 omitted 
> */
.         capture drop ev_l* ev_g*
 41.         forvalues k = 2/`NBIN' {
 42.                 gen byte ev_l`k' = (etime == -`k') & treated_unit == 1
 43.         }
 44.         local kmax = `NBIN' - 1
 45.         forvalues k = 0/`kmax' {
 46.                 gen byte ev_g`k' = (etime == `k') & treated_unit == 1
 47.         }
 48.         local es_dummies ""
 49.         forvalues k = `NBIN'(-1)2 {
 50.                 local es_dummies "`es_dummies' ev_l`k'"
 51.         }
 52.         forvalues k = 0/`kmax' {
 53.                 local es_dummies "`es_dummies' ev_g`k'"
 54.         }
 55. 
.         /* plot grid: 2*NBIN columns = bins -NBIN..-1, 0..NBIN-1
>            col 1..NBIN-1 = bins -NBIN..-2 ; col NBIN = bin -1 (reference, 0)
>            col NBIN+1..2*NBIN = bins 0..NBIN-1                              *
> /
.         local ncol = 2 * `NBIN'
 56.         local refcol = `NBIN'
 57. 
.         local outcomes mm_violent mm_nonviolent
 58. 
.         tempfile stackfull
 59.         save `stackfull'
 60. 
.         /* ---------- outcome loop ---------- */
.         local oc = 0
 61.         foreach y of local outcomes {
 62.                 local ++oc
 63. 
.                 if "`y'" == "mm_protests"   local ytitle "Number of protests"
 64.                 if "`y'" == "mm_violent"    local ytitle "Number of violen
> t protests"
 65.                 if "`y'" == "mm_nonviolent" local ytitle "Number of non-vi
> olent protests"
 66.                 if "`y'" == "mm_gvr"        local ytitle "Number of govt. 
> violent responses"
 67. 
.                 matrix M_ols_b   = J(1,`ncol',0)
 68.                 matrix M_ols_se  = J(1,`ncol',0)
 69.                 matrix M_dcdh_b  = J(1,`ncol',.)
 70.                 matrix M_dcdh_se = J(1,`ncol',.)
 71.                 matrix M_bjs_b   = J(1,`ncol',0)
 72.                 matrix M_bjs_se  = J(1,`ncol',0)
 73.                 matrix M_sa_b    = J(1,`ncol',0)
 74.                 matrix M_sa_se   = J(1,`ncol',0)
 75. 
.                 use `stackfull', clear
 76. 
.                 /* (1) OLS TWFE */
.                 di as result "--- OLS: `y' [`sample'] ---"
 77.                 reghdfe `y' D, absorb(unit_id etime) cluster(country_id)
 78.                 scalar b_ols_`oc'  = _b[D]
 79.                 scalar se_ols_`oc' = _se[D]
 80.                 scalar n_ols_`oc'  = e(N)
 81.                 quietly reghdfe `y' `es_dummies', absorb(unit_id etime) cl
> uster(country_id)
 82.                 local cc = 0
 83.                 forvalues k = `NBIN'(-1)2 {
 84.                         local ++cc
 85.                         matrix M_ols_b[1,`cc']  = _b[ev_l`k']
 86.                         matrix M_ols_se[1,`cc'] = _se[ev_l`k']
 87.                 }
 88.                 forvalues k = 0/`kmax' {
 89.                         matrix M_ols_b[1, `refcol'+1+`k']  = _b[ev_g`k']
 90.                         matrix M_ols_se[1, `refcol'+1+`k'] = _se[ev_g`k']
 91.                 }
 92. 
.                 /* (2) dCDH.
>                    did_multiplegt_dyn normalises at the reference bin (-1) an
> d returns
>                    NO coefficient there; it stores its dynamic effects as e(E
> ffect_k)
>                    (bins 0..NBIN-1) and e(Placebo_k) (bins -2..-NBIN).  We pl
> ace these
>                    in the matrix at their event-time columns and then insert 
> an explicit
>                    0 at the reference column, so dCDH shows a zero marker at 
> bin -1 in
>                    the plot, just like the other estimators. */
.                 di as result "--- dCDH: `y' [`sample'] ---"
 93.                 capture noisily did_multiplegt_dyn `y' unit_id etime D, //
> /
>                         effects(`NBIN') placebo(`=`NBIN'-1') cluster(country_
> id) graph_off
 94.                 if _rc == 0 {
 95.                         scalar b_dcdh_`oc'  = e(Av_tot_effect)
 96.                         scalar se_dcdh_`oc' = e(se_avg_total_effect)
 97.                         forvalues k = 1/`=`NBIN'-1' {
 98.                                 capture matrix M_dcdh_b[1, `refcol'-`k']  
> = e(Placebo_`k')
 99.                                 capture matrix M_dcdh_se[1, `refcol'-`k'] 
> = e(se_placebo_`k')
100.                         }
101.                         forvalues k = 1/`NBIN' {
102.                                 capture matrix M_dcdh_b[1, `refcol'+`k']  
> = e(Effect_`k')
103.                                 capture matrix M_dcdh_se[1, `refcol'+`k'] 
> = e(se_effect_`k')
104.                         }
105.                         matrix M_dcdh_b[1, `refcol']  = 0
106.                         matrix M_dcdh_se[1, `refcol'] = 0
107.                 }
108.                 else {
109.                         scalar b_dcdh_`oc' = .
110.                         scalar se_dcdh_`oc' = .
111.                         display in red "dCDH failed for `y' [`sample']"
112.                 }
113. 
.                 /* (3) BJS */
.                 di as result "--- BJS: `y' [`sample'] ---"
114.                 capture noisily did_imputation `y' unit_id etime cohort, /
> //
>                         autosample minn(0) delta(1) cluster(country_id)
115.                 if _rc == 0 {
116.                         scalar b_bjs_`oc'  = _b[tau]
117.                         scalar se_bjs_`oc' = _se[tau]
118.                 }
119.                 else {
120.                         scalar b_bjs_`oc' = .
121.                         scalar se_bjs_`oc' = .
122.                         display in red "BJS (static) failed for `y' [`samp
> le']"
123.                 }
124.                 capture noisily did_imputation `y' unit_id etime cohort, /
> //
>                         horizons(0/`kmax') pretrends(`NBIN') autosample minn(
> 0) delta(1) ///
>                         cluster(country_id)
125.                 if _rc == 0 {
126.                         forvalues k = 2/`NBIN' {
127.                                 capture quietly lincom pre`k' - pre1
128.                                 if _rc == 0 {
129.                                         matrix M_bjs_b[1, `refcol'+1-`k'] 
>  = r(estimate)
130.                                         matrix M_bjs_se[1, `refcol'+1-`k']
>  = r(se)
131.                                 }
132.                         }
133.                         forvalues k = 0/`kmax' {
134.                                 capture quietly lincom tau`k' - pre1
135.                                 if _rc == 0 {
136.                                         matrix M_bjs_b[1, `refcol'+1+`k'] 
>  = r(estimate)
137.                                         matrix M_bjs_se[1, `refcol'+1+`k']
>  = r(se)
138.                                 }
139.                         }
140.                 }
141. 
.                 /* (4) SA */
.                 di as result "--- SA: `y' [`sample'] ---"
142.                 capture noisily eventstudyinteract `y' `es_dummies', ///
>                         cohort(cohort) control_cohort(I_never_treated) ///
>                         absorb(unit_id etime) vce(cluster country_id)
143.                 if _rc == 0 {
144.                         matrix b_iw = e(b_iw)
145.                         matrix V_iw = e(V_iw)
146.                         local cc = 0
147.                         forvalues k = `NBIN'(-1)2 {
148.                                 local ++cc
149.                                 local j = colnumb(b_iw, "ev_l`k'")
150.                                 if `j' < . {
151.                                         matrix M_sa_b[1,`cc']  = b_iw[1,`j
> ']
152.                                         matrix M_sa_se[1,`cc'] = sqrt(V_iw
> [`j',`j'])
153.                                 }
154.                         }
155.                         forvalues k = 0/`kmax' {
156.                                 local j = colnumb(b_iw, "ev_g`k'")
157.                                 if `j' < . {
158.                                         matrix M_sa_b[1, `refcol'+1+`k']  
> = b_iw[1,`j']
159.                                         matrix M_sa_se[1, `refcol'+1+`k'] 
> = sqrt(V_iw[`j',`j'])
160.                                 }
161.                         }
162.                         matrix wgt = J(1, colsof(b_iw), 0)
163.                         local npost = 0
164.                         forvalues k = 0/`kmax' {
165.                                 local j = colnumb(b_iw, "ev_g`k'")
166.                                 if `j' < . {
167.                                         matrix wgt[1,`j'] = 1
168.                                         local ++npost
169.                                 }
170.                         }
171.                         if `npost' > 0 {
172.                                 matrix wgt = wgt / `npost'
173.                                 matrix avg_b = wgt * b_iw'
174.                                 matrix avg_V = wgt * V_iw * wgt'
175.                                 scalar b_sa_`oc'  = avg_b[1,1]
176.                                 scalar se_sa_`oc' = sqrt(avg_V[1,1])
177.                         }
178.                 }
179.                 else {
180.                         scalar b_sa_`oc' = .
181.                         scalar se_sa_`oc' = .
182.                         display in red "SA failed for `y' [`sample']"
183.                 }
184. 
.                 /* store static coefficients keyed by (window, outcome) for t
> he
>                    compact per-sample table assembled after the window loop *
> /
.                 foreach er in ols dcdh bjs sa {
185.                         scalar B_`er'_w`T'_`oc' = b_`er'_`oc'
186.                         scalar S_`er'_w`T'_`oc' = se_`er'_`oc'
187.                 }
188.                 scalar N_w`T'_`oc' = n_ols_`oc'
189. 
.                 /* ---------- combined event-study plot ---------- */
.                 preserve
190.                         clear
191.                         set obs `ncol'
192.                         gen bin = _n - `refcol' - 1        /* event bin: -
> NBIN..-1, 0..NBIN-1 */
193.                         gen days = bin * `BIN'             /* bin start in
>  days */
194.                         replace days = days + `BIN' if days >= 0   /* POST
>  bins -> right edge; PRE keep left edge */
195.                         foreach est in ols dcdh bjs sa {
196.                                 gen double b_`est'  = .
197.                                 gen double se_`est' = .
198.                                 forvalues j = 1/`ncol' {
199.                                         replace b_`est'  = M_`est'_b[1,`j'
> ]  in `j'
200.                                         replace se_`est' = M_`est'_se[1,`j
> '] in `j'
201.                                 }
202.                                 gen double ci_lo_`est' = b_`est' - 1.645*s
> e_`est'
203.                                 gen double ci_hi_`est' = b_`est' + 1.645*s
> e_`est'
204.                         }
205.                         gen double days_ols  = days - 0.21 * `BIN'
206.                         gen double days_dcdh = days - 0.07 * `BIN'
207.                         gen double days_bjs  = days + 0.07 * `BIN'
208.                         gen double days_sa   = days + 0.21 * `BIN'
209. 
.                         local labday = 15
210.                         if `NBIN' >= 6 local labday = 30
211.                         local xlabs ""
212.                         forvalues bb = -`NBIN'/`=`NBIN'-1' {
213.                                 if `bb' < 0 local dd = `bb' * `BIN'
214.                                 else        local dd = (`bb' + 1) * `BIN'
215.                                 if mod(`dd', `labday') == 0 local xlabs "`
> xlabs' `dd'"
216.                         }
217.                         local xpad   = 0.6 * `BIN'
218.                         local xlo_ax = -`NBIN' * `BIN' - `xpad'
219.                         local xhi_ax = `NBIN' * `BIN' + `xpad'
220. 
.                         twoway ///
>                                 (rspike ci_lo_ols  ci_hi_ols  days_ols,  lcol
> or(navy)         lwidth(medium)) ///
>                                 (scatter b_ols  days_ols,  mcolor(navy)      
>    msymbol(O)  msize(small)) ///
>                                 (rspike ci_lo_dcdh ci_hi_dcdh days_dcdh, lcol
> or(cranberry)    lwidth(medium)) ///
>                                 (scatter b_dcdh days_dcdh, mcolor(cranberry) 
>    msymbol(T)  msize(small)) ///
>                                 (rspike ci_lo_bjs  ci_hi_bjs  days_bjs,  lcol
> or(forest_green) lwidth(medium)) ///
>                                 (scatter b_bjs  days_bjs,  mcolor(forest_gree
> n) msymbol(D)  msize(small)) ///
>                                 (rspike ci_lo_sa   ci_hi_sa   days_sa,   lcol
> or(midblue)      lwidth(medium)) ///
>                                 (scatter b_sa   days_sa,   mcolor(midblue)   
>    msymbol(Oh) msize(small)), ///
>                                 yline(0, lcolor(red) lpattern(solid) lwidth(m
> edthin)) ///
>                                 xline(0, lcolor(black%20) lpattern(solid) lwi
> dth(vthick)) ///
>                                 xtitle("Days since scandal", size(large)) ///
>                                 ytitle("`ytitle'", size(large)) ///
>                                 xscale(range(`xlo_ax' `xhi_ax')) ///
>                                 xlabel(`xlabs', labsize(large)) ///
>                                 ylabel(, labsize(large) format(%4.3fc) angle(
> 0)) ///
>                                 legend(order(2 "OLS (TWFE)" 4 "dCDH" 6 "BJS" 
> 8 "SA") ///
>                                         rows(1) size(small) position(6) regio
> n(lcolor(none))) ///
>                                 graphregion(color(white)) scheme(s2color)
221.                         graph export "${figout}/did_modern_stk_es_`y'_`sam
> ple'_w`T'.pdf", replace
222.                 restore
223.         }
224.         }
