. foreach T in 30 60 90 120 {
  2.         local nb = `T' / `B'
  3. 
.         foreach sample in pa na {
  4.         foreach outcome in num_violent_MM num_peaceful_MM {
  5. 
.                 use `base', clear
  6.                 gen int ebin = .
  7.                 replace ebin =  floor(window / `B') + 1          if window
>  >= 0
  8.                 replace ebin = -(floor((-window - 1) / `B') + 1) if window
>  <  0
  9. 
.                 gen double w = cond(ebin < 0, ebin + 1, ebin)     /* linear t
> rend */
 10.                 local rhs "w"
 11.                 forvalues k = 1/`nb' {
