 13.                         local rhs "`rhs' p`k'"
 14.                 }
 15. 
.                 quietly reghdfe `outcome' `rhs' ///
>                         if year >= `firstyear' & abs(window) <= `T' & in_`sam
> ple' == 1, ///
>                         absorb(month day auxvar) cluster(group_cluster)
 16. 
.                 local labday = 15
 17.                 if `T' >= 90 local labday = 30
 18.                 local xlabs ""
 19.                 forvalues bi = -`nb'/`=`nb'-1' {
 20.                         if `bi' < 0 local d = `bi' * `B'
 21.                         else        local d = (`bi' + 1) * `B'
 22.                         if mod(`d', `labday') == 0 local xlabs "`xlabs' `d
> '"
 23.                 }
 24.                 local xpad   = 0.6 * `B'
 25.                 local xlo_ax = -`nb' * `B' - `xpad'
 26.                 local xhi_ax =  `nb' * `B' + `xpad'
 27. 
.                 preserve
 28.                         clear
 29.                         local npts = 2 * `nb'
 30.                         set obs `npts'
 31.                         gen int    bi  = _n - `nb' - 1
 32.                         gen double day = bi * `B'
 33.                         gen double b  = 0
 34.                         gen double se = 0
 35.                         forvalues j = 0/`=`nb'-1' {
 36.                                 local k = `j' + 1
 37.                                 quietly replace b  = _b[p`k']  if bi == `j
> '
 38.                                 quietly replace se = _se[p`k'] if bi == `j
> '
 39.                         }
 40.                         replace day = day + `B' if bi >= 0
 41.                         gen ci_lo = b - `zcrit' * se
 42.                         gen ci_hi = b + `zcrit' * se
 43. 
.                         twoway (rspike ci_lo ci_hi day, lcolor(black) lwidth(
> medthick)) ///
