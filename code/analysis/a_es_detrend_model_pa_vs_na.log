. /* ============================================================
>    PART 1 - POOLED (apex & non-apex jointly, group-specific trends)
>    ============================================================ */
. foreach T in 30 60 90 120 {
  2.         local nb = `T' / `B'
  3. 
.         foreach outcome in num_violent_MM num_peaceful_MM {
  4. 
.                 use `base', clear
  5.                 keep if year >= `firstyear' & abs(window) <= `T'
  6.                 gen int ebin = .
  7.                 replace ebin =  floor(window / `B') + 1          if window
>  >= 0
  8.                 replace ebin = -(floor((-window - 1) / `B') + 1) if window
>  <  0
  9. 
.                 /* continuous event-time index: 0 at the reference bin (ebin 
> -1),
>                    +1 per bin (no gap between the reference and the first pos
> t bin) */
.                 gen double et = cond(ebin < 0, ebin + 1, ebin)
 10.                 gen double w_pa = et * in_pa
 11.                 gen double w_na = et * in_na
 12. 
.                 /* post-period bin dummies (ebin 1..nb) by group */
.                 local rhs "w_pa w_na"
 13.                 forvalues k = 1/`nb' {
 14.                         gen byte pa_p`k' = (ebin == `k') & in_pa
 15.                         gen byte na_p`k' = (ebin == `k') & in_na
 16.                         local rhs "`rhs' pa_p`k' na_p`k'"
 17.                 }
 18. 
.                 quietly reghdfe `outcome' `rhs', ///
>                         absorb(month day auxvar) cluster(group_cluster)
 19. 
.                 /* x-axis labels */
.                 local labday = 15
 20.                 if `T' >= 90 local labday = 30
 21.                 local xlabs ""
 22.                 forvalues bi = -`nb'/`=`nb'-1' {
 23.                         if `bi' < 0 local d = `bi' * `B'
 24.                         else        local d = (`bi' + 1) * `B'
 25.                         if mod(`d', `labday') == 0 local xlabs "`xlabs' `d
> '"
 26.                 }
 27.                 local xpad   = 0.6 * `B'
 28.                 local xlo_ax = -`nb' * `B' - `xpad'
 29.                 local xhi_ax =  `nb' * `B' + `xpad'
 30. 
.                 preserve
 31.                         clear
 32.                         local npts = 2 * `nb'
 33.                         set obs `npts'
 34.                         /* plot index bi = -nb..nb-1 (bi = -1 is the refer
> ence); post
>                            points bi>=0 map to post dummy k = bi+1 (ebin = bi
> +1) */
.                         gen int    bi  = _n - `nb' - 1
 35.                         gen double day = bi * `B'
 36.                         gen double bpa = 0
 37.                         gen double sepa = 0
 38.                         gen double bna = 0
 39.                         gen double sena = 0
 40.                         forvalues j = 0/`=`nb'-1' {
 41.                                 local k = `j' + 1
 42.                                 quietly replace bpa  = _b[pa_p`k']  if bi 
> == `j'
 43.                                 quietly replace sepa = _se[pa_p`k'] if bi 
> == `j'
 44.                                 quietly replace bna  = _b[na_p`k']  if bi 
> == `j'
 45.                                 quietly replace sena = _se[na_p`k'] if bi 
> == `j'
 46.                         }
 47.                         replace day = day + `B' if bi >= 0
 48.                         gen ci_lo_pa = bpa - `zcrit' * sepa
 49.                         gen ci_hi_pa = bpa + `zcrit' * sepa
 50.                         gen ci_lo_na = bna - `zcrit' * sena
 51.                         gen ci_hi_na = bna + `zcrit' * sena
 52.                         gen double day_pa = day - 0.12 * `B'
 53.                         gen double day_na = day + 0.12 * `B'
 54. 
.                         twoway (rspike ci_lo_pa ci_hi_pa day_pa, lcolor(navy)
>  lwidth(medthick)) ///
>                                (scatter bpa day_pa, mcolor(navy) msymbol(O) m
> size(medium)) ///
>                                (rspike ci_lo_na ci_hi_na day_na, lcolor(cranb
> erry) lwidth(medthick)) ///
>                                (scatter bna day_na, mcolor(cranberry) msymbol
> (D) msize(medium)), ///
>                                 xline(0, lcolor(black%10) lwidth(vvthick) lpa
> ttern(solid)) ///
>                                 yline(0, lpattern(dash) lcolor(black)) ///
>                                 ytitle("Effect on protests (linear-trend mode
> l)", size(medium)) ///
>                                 ylabel(, labsize(large) format(%5.3fc) angle(
> 0)) ///
>                                 xtitle("Days since scandal", size(large)) ///
>                                 xscale(range(`xlo_ax' `xhi_ax')) ///
>                                 xlabel(`xlabs', labsize(large)) ///
>                                 legend(order(2 "Apex" 4 "Non-Apex") rows(1) s
> ize(medium) ///
>                                         position(6) region(lcolor(none))) ///
>                                 graphregion(color(white) fcolor(white)) schem
> e(s2color)
 55.                         graph export ///
>                                 "${figout}/es_pooled_`outcome'_w`T'_b`B'_ols_
> `ci_level'ci_dtm.pdf", ///
>                                 replace
 56.                 restore
 57.         }
 58. }
