. /* ============================================================
>    ESTIMATION: RD jump (tau) for sample x outcome x bandwidth x poly
>    ============================================================ */
. tempname R

. tempfile rdres

. postfile `R' str4 sample str16 outcome int bw int poly ///
>         double tau double se double n using "`rdres'", replace
(file C:\Users\rob98\AppData\Local\Temp\ST_93f0_000003.tmp not found)

. 
. foreach sample in pa na {
  2. foreach oc in num_violent_MM num_peaceful_MM {
  3. foreach BW in 30 60 90 {
  4. 
.         /* local linear: Post + rv + Post#rv */
.         use `base', clear
  5.         quietly reghdfe `oc' i.Post##c.rv ///
>                 if year >= `firstyear' & abs(rv) <= `BW' & in_`sample' == 1, 
> ///
>                 absorb(month day auxvar) cluster(group_cluster)
  6.         post `R' ("`sample'") ("`oc'") (`BW') (1) ///
>                 (_b[1.Post]) (_se[1.Post]) (e(N))
  7. 
.         /* local quadratic: Post + rv + rv^2, each interacted with Post */
.         use `base', clear
  8.         quietly reghdfe `oc' i.Post##c.rv i.Post##c.rv#c.rv ///
>                 if year >= `firstyear' & abs(rv) <= `BW' & in_`sample' == 1, 
> ///
>                 absorb(month day auxvar) cluster(group_cluster)
  9.         post `R' ("`sample'") ("`oc'") (`BW') (2) ///
>                 (_b[1.Post]) (_se[1.Post]) (e(N))
 10. }
 11. }
 12. }

. postclose `R'

. 
. /* ============================================================
>    TABLE: rows = Apex/Non-Apex x poly; cols = Violent/Non... x bw
>    ============================================================ */
. use "`rdres'", clear

. capture file close _tbl

. file open _tbl using "${tabout}/sup_rd_time.tex", write replace

. file write _tbl "{" _n

. file write _tbl "\def\sym#1{\ifmmode^{#1}\else\(^{#1}\)\fi}" _n

. file write _tbl "\begin{tabular}{ll*{6}{c}}" _n

. file write _tbl "\toprule" _n

. file write _tbl " & & \multicolumn{3}{c}{Violent Protests} & \multicolumn{3}{
> c}{Peaceful Protests} \\" _n

. file write _tbl "\cmidrule(lr){3-5}\cmidrule(lr){6-8}" _n

. file write _tbl " & & \ensuremath{h=30} & \ensuremath{h=60} & \ensuremath{h=9
> 0} & \ensuremath{h=30} & \ensuremath{h=60} & \ensuremath{h=90} \\" _n

. file write _tbl "\midrule" _n

. 
. foreach s in pa na {
  2.         if "`s'" == "pa" local slab "Apex"
  3.         else             local slab "Non-Apex"
  4.         file write _tbl "\multicolumn{8}{l}{\textit{`slab'}}\\" _n
  5.         foreach p in 1 2 {
  6.                 if `p' == 1 local plab "Local linear"
  7.                 else        local plab "Local quadratic"
  8.                 local brow "`plab' &"
  9.                 local srow " &"
 10.                 foreach oc in num_violent_MM num_peaceful_MM {
 11.                 foreach BW in 30 60 90 {
 12.                         quietly summarize tau if sample=="`s'" & outcome==
> "`oc'" & bw==`BW' & poly==`p', meanonly
 13.                         local b = r(mean)
 14.                         quietly summarize se if sample=="`s'" & outcome=="
> `oc'" & bw==`BW' & poly==`p', meanonly
 15.                         local se = r(mean)
 16.                         if missing(`b') | missing(`se') | `se' <= 0 {
 17.                                 local brow "`brow' & --"
 18.                                 local srow "`srow' & "
 19.                         }
 20.                         else {
 21.                                 local pv = 2*normal(-abs(`b'/`se'))
 22.                                 local st = ""
 23.                                 if `pv' < 0.10 local st = "*"
 24.                                 if `pv' < 0.05 local st = "**"
 25.                                 if `pv' < 0.01 local st = "***"
 26.                                 if "`st'" != "" local bcell = string(`b',"
> %5.3f") + "\sym{`st'}"
 27.                                 else            local bcell = string(`b',"
> %5.3f")
 28.                                 local scell = "(" + string(`se',"%5.3f") +
>  ")"
 29.                                 local brow "`brow' & `bcell'"
 30.                                 local srow "`srow' & `scell'"
 31.                         }
 32.                 }
 33.                 }
 34.                 file write _tbl "`brow' \\" _n
 35.                 file write _tbl "`srow' \\" _n
 36.         }
 37.         if "`s'" == "pa" file write _tbl "\midrule" _n
 38. }

. file write _tbl "\bottomrule" _n

. file write _tbl "\end{tabular}" _n

. file write _tbl "}" _n

. file close _tbl

. display in green "sup_rd_time.tex written"
sup_rd_time.tex written

