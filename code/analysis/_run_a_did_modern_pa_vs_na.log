. /* ============================================================
>    SAMPLE x WINDOW LOOP
>    ============================================================ */
. foreach sample in pa na {
  2. 
.         foreach T in 30 60 90 120 {
  3. 
.         local nbin = `T' / `BIN'          /* bins per side: 2, 4, 6, 8 */
  4. 
.         di as result _newline _newline ///
>                 "============================================================
> =====" _n ///
>                 "   DID MODERN (15-day bins)  --  sample=`sample'  window=+-`
> T' (`nbin' bins/side)" _n ///
>                 "============================================================
> ====="
  5. 
.         /* ---- attach subsample first-scandal date and its bin ---- */
.         use `binpanel', clear
  6.         if "`sample'" == "pa" {
  7.                 merge m:1 country using `pa_dates', keep(1 3) nogenerate
  8.                 rename fs_pa first_scandal_date
  9.         }
 10.         else {
 11.                 merge m:1 country using `na_dates', keep(1 3) nogenerate
 12.                 rename fs_na first_scandal_date
 13.         }
 14.         format first_scandal_date %td
 15. 
.         gen long first_scandal_bin = ///
>                 floor((first_scandal_date - `anchor') / `BIN') + 1 ///
>                 if !missing(first_scandal_date)
 16. 
.         gen byte ever_treated = !missing(first_scandal_date)
 17. 
.         /* Clean controls: a never-treated (in-subsample) country enters the
>            control pool only through its country-years with NO scandal of any
>            type; its scandal-contaminated country-years are dropped. Treated
>            countries keep their full trajectory---their own pre-period is the
>            within-country control. */
.         drop if ever_treated == 0 & cy_any_scandal == 1
 18. 
.         gen byte D = ever_treated == 1 & bin_idx >= first_scandal_bin
 19.         gen long cohort = first_scandal_bin
 20.         replace cohort = 999999 if missing(cohort)
 21.         gen byte I_never_treated = (ever_treated == 0)
 22. 
.         xtset country_id bin_idx
 23. 
.         /* ---- event-time dummies in 15-day bins ----
>            leads -nbin..-2 (ref -1 omitted), lags 0..nbin-1 */
.         gen long etime = bin_idx - first_scandal_bin if ever_treated == 1
 24.         local es_dummies ""
 25.         forvalues k = `nbin'(-1)2 {
 26.                 capture drop ev_lead`k'
 27.                 gen byte ev_lead`k' = (etime == -`k') & ever_treated == 1
 28.                 local es_dummies "`es_dummies' ev_lead`k'"
 29.         }
 30.         forvalues k = 0/`=`nbin'-1' {
 31.                 capture drop ev_lag`k'
 32.                 gen byte ev_lag`k' = (etime == `k') & ever_treated == 1
 33.                 local es_dummies "`es_dummies' ev_lag`k'"
 34.         }
 35. 
.         tempfile wdata
 36.         save `wdata'
 37. 
.         local outcomes mm_violent mm_nonviolent
 38. 
.         /* number of plotted event-time slots: bins -nbin..(nbin-1) */
.         local nslot = 2 * `nbin'
 39.         /* slot(bin b) = b + nbin + 1 ; reference b=-1 -> slot nbin stays 
> 0 */
. 
.         local oc = 0
 40.         foreach y of local outcomes {
 41.                 local ++oc
 42.                 use `wdata', clear
 43. 
.                 if "`y'" == "mm_protests"   local ytitle "Number of protests"
 44.                 if "`y'" == "mm_violent"    local ytitle "Number of violen
> t protests"
 45.                 if "`y'" == "mm_nonviolent" local ytitle "Number of non-vi
> olent protests"
 46.                 if "`y'" == "mm_gvr"        local ytitle "Number of govt. 
> violent responses"
 47. 
.                 matrix M_ols_b   = J(1, `nslot', 0)
 48.                 matrix M_ols_se  = J(1, `nslot', 0)
 49.                 matrix M_dcdh_b  = J(1, `nslot', .)
 50.                 matrix M_dcdh_se = J(1, `nslot', .)
 51.                 matrix M_bjs_b   = J(1, `nslot', 0)
 52.                 matrix M_bjs_se  = J(1, `nslot', 0)
 53.                 matrix M_sa_b    = J(1, `nslot', 0)
 54.                 matrix M_sa_se   = J(1, `nslot', 0)
 55. 
.                 /* (1) OLS TWFE */
.                 di as result "--- OLS: `y' [`sample' w`T'] ---"
 56.                 reghdfe `y' D, absorb(country_id bin_idx) cluster(country_
> id)
 57.                 scalar b_ols_`oc'  = _b[D]
 58.                 scalar se_ols_`oc' = _se[D]
 59.                 scalar n_ols_`oc'  = e(N)
 60.                 quietly reghdfe `y' `es_dummies', ///
>                         absorb(country_id bin_idx) cluster(country_id)
 61.                 forvalues k = `nbin'(-1)2 {
 62.                         local slot = -`k' + `nbin' + 1
 63.                         matrix M_ols_b[1, `slot']  = _b[ev_lead`k']
 64.                         matrix M_ols_se[1, `slot'] = _se[ev_lead`k']
 65.                 }
 66.                 forvalues k = 0/`=`nbin'-1' {
 67.                         local slot = `k' + `nbin' + 1
 68.                         matrix M_ols_b[1, `slot']  = _b[ev_lag`k']
 69.                         matrix M_ols_se[1, `slot'] = _se[ev_lag`k']
 70.                 }
 71. 
.                 /* (2) dCDH.
>                    did_multiplegt_dyn normalises at the reference bin (-1) an
> d returns
>                    NO coefficient there; it stores its dynamic effects as e(E
> ffect_k)
>                    (bins 0..nbin-1) and e(Placebo_k) (bins -2..-nbin).  We pl
> ace these
>                    in the matrix at their event-time slots and then insert an
>  explicit
>                    0 at the reference slot, so dCDH shows a zero marker at bi
> n -1 in the
>                    plot, just like the other estimators. */
.                 di as result "--- dCDH: `y' [`sample' w`T'] ---"
 72.                 capture noisily did_multiplegt_dyn `y' country_id bin_idx 
> D, ///
>                         effects(`nbin') placebo(`=`nbin'-1') cluster(country_
> id) graph_off
 73.                 if _rc == 0 {
 74.                         scalar b_dcdh_`oc'  = e(Av_tot_effect)
 75.                         scalar se_dcdh_`oc' = e(se_avg_total_effect)
 76.                         forvalues k = 1/`=`nbin'-1' {
 77.                                 local slot = -(`k'+1) + `nbin' + 1
 78.                                 capture matrix M_dcdh_b[1, `slot']  = e(Pl
> acebo_`k')
 79.                                 capture matrix M_dcdh_se[1, `slot'] = e(se
> _placebo_`k')
 80.                         }
 81.                         forvalues k = 1/`nbin' {
 82.                                 local slot = (`k'-1) + `nbin' + 1
 83.                                 capture matrix M_dcdh_b[1, `slot']  = e(Ef
> fect_`k')
 84.                                 capture matrix M_dcdh_se[1, `slot'] = e(se
> _effect_`k')
 85.                         }
 86.                         matrix M_dcdh_b[1, `nbin']  = 0
 87.                         matrix M_dcdh_se[1, `nbin'] = 0
 88.                 }
 89.                 else {
 90.                         scalar b_dcdh_`oc' = .
 91.                         scalar se_dcdh_`oc' = .
 92.                         display in red "dCDH failed for `y' [`sample' w`T'
> ]"
 93.                 }
 94. 
.                 /* (3) BJS */
.                 di as result "--- BJS: `y' [`sample' w`T'] ---"
 95.                 capture noisily did_imputation `y' country_id bin_idx firs
> t_scandal_bin, ///
>                         autosample minn(0) delta(1) cluster(country_id)
 96.                 if _rc == 0 {
 97.                         scalar b_bjs_`oc'  = _b[tau]
 98.                         scalar se_bjs_`oc' = _se[tau]
 99.                 }
100.                 else {
101.                         scalar b_bjs_`oc' = .
102.                         scalar se_bjs_`oc' = .
103.                         display in red "BJS (static) failed for `y' [`samp
> le' w`T']"
104.                 }
105.                 capture noisily did_imputation `y' country_id bin_idx firs
> t_scandal_bin, ///
>                         horizons(0/`=`nbin'-1') pretrends(`nbin') ///
>                         autosample minn(0) delta(1) cluster(country_id)
106.                 if _rc == 0 {
107.                         forvalues k = 2/`nbin' {
108.                                 local slot = -`k' + `nbin' + 1
109.                                 capture quietly lincom pre`k' - pre1
110.                                 if _rc == 0 {
111.                                         matrix M_bjs_b[1, `slot']  = r(est
> imate)
112.                                         matrix M_bjs_se[1, `slot'] = r(se)
113.                                 }
114.                         }
115.                         forvalues k = 0/`=`nbin'-1' {
116.                                 local slot = `k' + `nbin' + 1
117.                                 capture quietly lincom tau`k' - pre1
118.                                 if _rc == 0 {
119.                                         matrix M_bjs_b[1, `slot']  = r(est
> imate)
120.                                         matrix M_bjs_se[1, `slot'] = r(se)
121.                                 }
122.                         }
123.                 }
124. 
.                 /* (4) SA */
.                 di as result "--- SA: `y' [`sample' w`T'] ---"
125.                 capture noisily eventstudyinteract `y' `es_dummies', ///
>                         cohort(cohort) control_cohort(I_never_treated) ///
>                         absorb(country_id bin_idx) vce(cluster country_id)
126.                 if _rc == 0 {
127.                         matrix b_iw = e(b_iw)
128.                         matrix V_iw = e(V_iw)
129.                         forvalues k = `nbin'(-1)2 {
130.                                 local slot = -`k' + `nbin' + 1
131.                                 local j = colnumb(b_iw, "ev_lead`k'")
132.                                 if `j' < . {
133.                                         matrix M_sa_b[1, `slot']  = b_iw[1
> , `j']
134.                                         matrix M_sa_se[1, `slot'] = sqrt(V
> _iw[`j', `j'])
135.                                 }
136.                         }
137.                         forvalues k = 0/`=`nbin'-1' {
138.                                 local slot = `k' + `nbin' + 1
139.                                 local j = colnumb(b_iw, "ev_lag`k'")
140.                                 if `j' < . {
141.                                         matrix M_sa_b[1, `slot']  = b_iw[1
> , `j']
142.                                         matrix M_sa_se[1, `slot'] = sqrt(V
> _iw[`j', `j'])
143.                                 }
144.                         }
145.                         /* static SA = simple average of post-period IW co
> efficients */
.                         matrix wgt = J(1, colsof(b_iw), 0)
146.                         local npost = 0
147.                         forvalues k = 0/`=`nbin'-1' {
148.                                 local j = colnumb(b_iw, "ev_lag`k'")
149.                                 if `j' < . {
150.                                         matrix wgt[1, `j'] = 1
151.                                         local ++npost
152.                                 }
153.                         }
154.                         if `npost' > 0 {
155.                                 matrix wgt = wgt / `npost'
156.                                 matrix avg_b = wgt * b_iw'
157.                                 matrix avg_V = wgt * V_iw * wgt'
158.                                 scalar b_sa_`oc'  = avg_b[1,1]
159.                                 scalar se_sa_`oc' = sqrt(avg_V[1,1])
160.                         }
161.                 }
162.                 else {
163.                         scalar b_sa_`oc' = .
164.                         scalar se_sa_`oc' = .
165.                         display in red "SA failed for `y' [`sample' w`T']"
166.                 }
167. 
.                 /* ---------- store event-study coefficients (drawn later on 
> a
>                    common per-outcome y-scale) ---------- */
.                 forvalues j = 1/`nslot' {
168.                         local bin = `j' - `nbin' - 1
169.                         post `P' ("`y'") ("`sample'") (`T') (`j') (`bin' *
>  `BIN') ///
>                                 (M_ols_b[1,`j'])  (M_ols_se[1,`j'])  ///
>                                 (M_dcdh_b[1,`j']) (M_dcdh_se[1,`j']) ///
>                                 (M_bjs_b[1,`j'])  (M_bjs_se[1,`j'])  ///
>                                 (M_sa_b[1,`j'])   (M_sa_se[1,`j'])
170.                 }
171. 
.                 /* store the static coefficients keyed by (window, outcome) s
> o the
>                    compact per-sample table can be assembled after the window
>  loop */
.                 foreach er in ols dcdh bjs sa {
172.                         scalar B_`er'_w`T'_`oc' = b_`er'_`oc'
173.                         scalar S_`er'_w`T'_`oc' = se_`er'_`oc'
174.                 }
175.                 scalar N_w`T'_`oc' = n_ols_`oc'
176.         }
177. 
.         /* ---------- compact per-sample table, written once after the last
>            window: rows are the four estimators, columns are outcome x window
>            (Violent / Non-violent / Protests, each at +-60/90/120; the
>            government-violent-response outcome is dropped). ---------- */
.         if `T' == 120 {
178.                 capture file close _tbl
179.                 file open _tbl using "${tabout}/did_modern_main_`sample'.t
> ex", write replace
180.                 file write _tbl "{" _n
181.                 file write _tbl "\def\sym#1{\ifmmode^{#1}\else\(^{#1}\)\fi
> }" _n
182.                 file write _tbl "\begin{tabular}{l*{8}{c}}" _n
183.                 file write _tbl "\toprule" _n
184.                 file write _tbl " & \multicolumn{4}{c}{Violent Protests} &
>  \multicolumn{4}{c}{Non-violent Protests} \\" _n
185.                 file write _tbl "\cmidrule(lr){2-5}\cmidrule(lr){6-9}" _n
186.                 file write _tbl " & \ensuremath{\pm 30} & \ensuremath{\pm 
> 60} & \ensuremath{\pm 90} & \ensuremath{\pm 120} & \ensuremath{\pm 30} & \ens
> uremath{\pm 60} & \ensuremath{\pm 90} & \ensuremath{\pm 120} \\" _n
187.                 file write _tbl "\midrule" _n
188.                 foreach er in ols dcdh bjs sa {
189.                         if "`er'" == "ols"  local rowlab "OLS (TWFE)"
190.                         if "`er'" == "dcdh" local rowlab "dCDH"
191.                         if "`er'" == "bjs"  local rowlab "BJS"
192.                         if "`er'" == "sa"   local rowlab "SA"
193.                         local brow "`rowlab'"
194.                         local srow "            "
195.                         foreach oc of numlist 1/2 {
196.                         foreach TT of numlist 30 60 90 120 {
197.                                 local b = B_`er'_w`TT'_`oc'
198.                                 local s = S_`er'_w`TT'_`oc'
199.                                 if missing(`b') | missing(`s') | `s' <= 0 
> {
200.                                         local brow "`brow' & --"
201.                                         local srow "`srow' & "
202.                                 }
203.                                 else {
204.                                         local pv = 2*normal(-abs(`b'/`s'))
205.                                         local st = ""
206.                                         if `pv' < 0.10 local st = "*"
207.                                         if `pv' < 0.05 local st = "**"
208.                                         if `pv' < 0.01 local st = "***"
209.                                         if "`st'" != "" local bcell = stri
> ng(`b',"%5.3f") + "\sym{`st'}"
210.                                         else            local bcell = stri
> ng(`b',"%5.3f")
211.                                         local scell = "(" + string(`s',"%5
> .3f") + ")"
212.                                         local brow "`brow' & `bcell'"
213.                                         local srow "`srow' & `scell'"
214.                                 }
215.                         }
216.                         }
217.                         file write _tbl "`brow' \\" _n
218.                         file write _tbl "`srow' \\" _n
219.                 }
220.                 file write _tbl "\midrule" _n
221.                 local nrow "Observations"
222.                 foreach oc of numlist 1/2 {
223.                 foreach TT of numlist 30 60 90 120 {
224.                         local ncell = trim(string(N_w`TT'_`oc', "%12.0fc")
> )
225.                         local nrow "`nrow' & `ncell'"
226.                 }
227.                 }
228.                 file write _tbl "`nrow' \\" _n
229.                 file write _tbl "\bottomrule" _n
230.                 file write _tbl "\end{tabular}" _n
231.                 file write _tbl "}" _n
232.                 file close _tbl
233.                 display in green "did_modern_main_`sample'.tex written"
234.         }
235. 
.         }
236. }


