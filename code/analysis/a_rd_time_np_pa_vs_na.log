. /* --- common y-range across all bandwidth x sample x outcome (same rule as
>    the parametric figures, so every RD figure shares one vertical scale) --- 
> */
. local gmax = 0

. foreach BW in 30 60 90 {
  2. foreach sample in pa na {
  3. foreach oc in num_violent_MM num_peaceful_MM {
  4.         use `base', clear
  5.         keep if year >= `firstyear' & abs(rv) <= `BW' & in_`sample' == 1
  6.         quietly reghdfe `oc', absorb(month day auxvar) residuals(_ry0)
  7.         gen int _wb0 = 5 * floor(rv / 5) + 2
  8.         quietly collapse (mean) _ry0, by(_wb0)
  9.         quietly summarize _ry0
 10.         local gmax = max(`gmax', abs(r(min)), abs(r(max)))
 11. }
 12. }
 13. }
