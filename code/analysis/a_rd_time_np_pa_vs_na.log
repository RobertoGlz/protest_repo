file
    C:\Users\rob98/Dropbox/Corrupcion/protest_repo/paper/figures/rd_time_np_n
    > um_peaceful_MM_na_h90.pdf saved as PDF format

. postclose `R'

. 
. /* ============================================================
>    TABLE: non-parametric (rdrobust) RD estimates, windows h in {30,60,90}
>    ============================================================ */
. use "`rdnp'", clear

. capture file close _tbl

. file open _tbl using "${tabout}/sup_rd_time_np.tex", write replace

. file write _tbl "{" _n

. file write _tbl "\def\sym#1{\ifmmode^{#1}\else\(^{#1}\)\fi}" _n

. file write _tbl "\begin{tabular}{l*{6}{c}}" _n

. file write _tbl "\toprule" _n

. file write _tbl " & \multicolumn{3}{c}{Violent Protests} & \multicolumn{3}{c}
> {Peaceful Protests} \\" _n

. file write _tbl "\cmidrule(lr){2-4}\cmidrule(lr){5-7}" _n

. file write _tbl " & \ensuremath{h=30} & \ensuremath{h=60} & \ensuremath{h=90}
>  & \ensuremath{h=30} & \ensuremath{h=60} & \ensuremath{h=90} \\" _n

. file write _tbl "\midrule" _n

. foreach s in pa na {
  2.         if "`s'" == "pa" local slab "Apex"
  3.         else             local slab "Non-Apex"
  4.         local brow "`slab'"
  5.         local srow " "
  6.         foreach oc in num_violent_MM num_peaceful_MM {
  7.         foreach BW in 30 60 90 {
  8.                 quietly summarize tau if sample=="`s'" & outcome=="`oc'" &
>  bw==`BW', meanonly
  9.                 local b = r(mean)
 10.                 quietly summarize se if sample=="`s'" & outcome=="`oc'" & 
> bw==`BW', meanonly
 11.                 local se = r(mean)
 12.                 if missing(`b') | missing(`se') | `se' <= 0 {
 13.                         local brow "`brow' & --"
 14.                         local srow "`srow' & "
 15.                 }
 16.                 else {
 17.                         local pv = 2*normal(-abs(`b'/`se'))
 18.                         local st = ""
 19.                         if `pv' < 0.10 local st = "*"
 20.                         if `pv' < 0.05 local st = "**"
 21.                         if `pv' < 0.01 local st = "***"
 22.                         if "`st'" != "" local bcell = string(`b',"%5.3f") 
> + "\sym{`st'}"
 23.                         else            local bcell = string(`b',"%5.3f")
 24.                         local scell = "(" + string(`se',"%5.3f") + ")"
 25.                         local brow "`brow' & `bcell'"
 26.                         local srow "`srow' & `scell'"
 27.                 }
 28.         }
 29.         }
 30.         file write _tbl "`brow' \\" _n
 31.         file write _tbl "`srow' \\" _n
 32. }

. file write _tbl "\bottomrule" _n

. file write _tbl "\end{tabular}" _n

. file write _tbl "}" _n

. file close _tbl

. display in green "sup_rd_time_np.tex written"
sup_rd_time_np.tex written

. 
. display in green "a_rd_time_np_pa_vs_na.do finished OK"
a_rd_time_np_pa_vs_na.do finished OK

. capture log close _all

. 
end of do-file
