. do "${progdir}/rdd_lpoly.do"

. /* --------------------------------------------------------------------------
> --
>    Apex corruption protests paper
> 
>    RD-in-time helper: non-parametric (local-polynomial) RD estimate + plot.
>    Adapted from ~/research-repos/electoral_bbj_repo/code/programs/rdd_lpoly.d
> o
>    (author: Roberto Gonzalez) for this project:
>      - running variable is event-time in DAYS (integer x-axis labels);
>      - the outcome passed in is ALREADY residualised on the fixed effects
>        (so no covariate partialling here); pass covs() only if you want extra
>        linear controls;
>      - graphs export to PDF;
>      - the estimate (tau, se, p) is returned in r().
> 
>    Uses rdrobust for the estimate/bandwidth and lpolyci for the fit.
> ---------------------------------------------------------------------------- 
> */
. 
. capture program drop rdd_lpoly

. program define rdd_lpoly, rclass
  1. 
.         syntax [if], outcome(varname) runvar(varname) rangemin(real) rangemax
> (real) ///
>                 cluster(varname) kernel(string) bwscale(real) bwselect(string
> )   ///
>                 outputfolder(string) [covs(varlist)] [ytitle(string)]        
>     ///
>                 [graphname(string)] [cilevel(integer 90)] [polycolor(string)]
>     ///
>                 [xstep(real 15)] [ylo(real 0)] [yhi(real 0)] [ystep(real 0.02
> )]  ///
>                 [nbins(integer 12)]
  2. 
.         marksample touse, novarlist
  3.         markout `touse' `outcome' `runvar'
  4.         quietly replace `touse' = 0 if `runvar' < `rangemin' | `runvar' > 
> `rangemax'
  5. 
.         local cov_opt ""
  6.         if "`covs'" != "" local cov_opt "covs(`covs')"
  7. 
.         /* ---- data-driven bandwidth, then re-estimate at scaled bandwidth -
> --- */
.         rdrobust `outcome' `runvar' if `touse', c(0) kernel(`kernel') ///
>                 bwselect(`bwselect') vce(cluster `cluster') `cov_opt' all
  8.         local h_opt    = e(h_l)
  9.         local h_scaled = `h_opt' * `bwscale'
 10. 
.         rdrobust `outcome' `runvar' if `touse', c(0) kernel(`kernel') ///
>                 h(`h_scaled') vce(cluster `cluster') `cov_opt' all
 11.         local coef = e(tau_cl)
 12.         local se   = e(se_tau_cl)
 13. 
.         /* ---- residualise on extra covariates for plotting (usually none) -
> --- */
.         tempvar yplot
 14.         if "`covs'" != "" {
 15.                 quietly regress `outcome' `covs' if `touse'
 16.                 quietly predict `yplot' if `touse', residuals
 17.         }
 18.         else {
 19.                 quietly generate double `yplot' = `outcome' if `touse'
 20.         }
 21. 
.         if "`ytitle'" == ""    local ytitle "`outcome'"
 22.         if "`polycolor'" == "" local polycolor "0 71 133"
 23. 
.         local tau_p = 2*normal(-abs(`coef'/`se'))
 24.         if `tau_p' < 0.01 {
 25.                 local TAU = "{&tau} = " + string(`coef', "%6.3fc") + " (p 
> < 0.01)"
 26.         }
 27.         else {
 28.                 local TAU = "{&tau} = " + string(`coef', "%6.3fc") + " (p 
> = " + string(`tau_p', "%4.3fc") + ")"
 29.         }
 30. 
.         /* ---- equal-width binned means either side of the cutoff ---- */
.         /* fixed number of equal-width bins per side (nbins), independent of 
> the
>            estimation bandwidth, so the scatter shows enough points */
.         local totbins_l = `nbins'
 31.         local totbins_r = `nbins'
 32.         local bw_l = abs(`rangemin') / `totbins_l'
 33.         local bw_r = `rangemax' / `totbins_r'
 34.         capture drop _rdbin _rvb _ycb
 35.         quietly generate _rdbin = min(floor((`runvar' - `rangemin') / `bw_
> l') + 1, `totbins_l') if `touse' & `runvar' < 0
 36.         quietly replace  _rdbin = min(floor(`runvar' / `bw_r') + 1, `totbi
> ns_r')                if `touse' & `runvar' >= 0
 37.         quietly generate _rvb = `rangemin' + (_rdbin - 0.5) * `bw_l' if `t
> ouse' & `runvar' < 0
 38.         quietly replace  _rvb = (_rdbin - 0.5) * `bw_r'             if `to
> use' & `runvar' >= 0
 39.         quietly generate _ycb = .
 40.         quietly bysort _rdbin : egen _tm = mean(`yplot') if `touse' & `run
> var' < 0
 41.         quietly replace _ycb = _tm if `touse' & `runvar' < 0
 42.         drop _tm
 43.         quietly bysort _rdbin : egen _tm = mean(`yplot') if `touse' & `run
> var' >= 0
 44.         quietly replace _ycb = _tm if `touse' & `runvar' >= 0
 45.         drop _tm
 46. 
.         local kp "`kernel'"
 47.         if "`kernel'" == "triangular" local kp "triangle"
 48. 
.         if `ylo' != `yhi' {
 49.                 local yopts "yscale(range(`ylo' `yhi')) ylabel(`ylo'(`yste
> p')`yhi', labsize(medium) format(%4.3fc) angle(horizontal))"
 50.         }
 51.         else {
 52.                 local yopts "ylabel(, labsize(medium) format(%4.3fc) angle
> (horizontal))"
 53.         }
 54. 
.         twoway ///
>                 (lpolyci `yplot' `runvar' if `touse' & `runvar' < 0 & inrange
> (`runvar', `rangemin', `rangemax'), ///
>                         kernel(`kp') bwidth(`h_scaled') degree(1) level(`cile
> vel') ///
>                         acolor("`polycolor'%20") alwidth(none) lcolor("`polyc
> olor'") lpattern(solid)) ///
>                 (lpolyci `yplot' `runvar' if `touse' & `runvar' >= 0 & inrang
> e(`runvar', `rangemin', `rangemax'), ///
>                         kernel(`kp') bwidth(`h_scaled') degree(1) level(`cile
> vel') ///
>                         acolor("`polycolor'%20") alwidth(none) lcolor("`polyc
> olor'") lpattern(solid)) ///
>                 (scatter _ycb _rvb if `touse' & inrange(_rvb, `rangemin', `ra
> ngemax'), ///
>                         msize(medsmall) msymbol(O) color("`polycolor'")), ///
>                 xline(0, lcolor(black%25) lwidth(medthick)) ///
>                 legend(order(1 "`cilevel'% CI" 2 "Local linear fit" 3 "Binned
>  means" - "`TAU'") ///
>                         row(2) pos(6) region(lcolor(gs10))) ///
>                 xlabel(`rangemin'(`xstep')`rangemax', labsize(medium) nogrid)
>  ///
>                 `yopts' ///
>                 ytitle("`ytitle'", size(medium)) ///
>                 xtitle("Days since scandal", size(medium)) ///
>                 graphregion(color(white) fcolor(white)) scheme(s2color) ///
>                 note("Bandwidth h = `=round(`h_scaled', 1)' days (scale `bwsc
> ale' of MSE-optimal); kernel `kernel'.", size(vsmall))
 55. 
.         if "`graphname'" == "" local graphname "rdd_`outcome'"
 56.         capture mkdir "`outputfolder'"
 57.         graph export "`outputfolder'/`graphname'.pdf", replace
 58.         capture drop _rdbin _rvb _ycb
 59. 
.         return scalar tau  = `coef'
 60.         return scalar se   = `se'
 61.         return scalar pval = `tau_p'
 62.         return scalar h    = `h_scaled'
 63. end

. 
end of do-file

